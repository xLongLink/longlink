<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink version="v1" name="Requests" icon="clipboard-list">
    <Query id="request" path="/api/requests/${params.request}" />
    <Query id="attachments" path="/api/requests/${params.request}/attachments" />
    <State id="attachment" file="${null}" />

    <Stack direction="horizontal" justify="between" align="center" wrap="wrap" gap="3">
        <Stack>
            <Heading level="3" value="$request.text" />
            <Text color="secondary" value="${`CHF ${request.amount}`}" />
        </Stack>
        <Dialog i18n="requests.attachments.title" triggerLabel="Upload attachment" purpose="form">
            <Stack gap="3">
                <FileInput i18n="requests.attachments.file" value="$attachment.file" isRequired="true" />
                <Action
                    action="/api/requests/${params.request}/attachments"
                    method="POST"
                    invalidate='${["attachments"]}'
                    closeDialog="true"
                    form="${{ file: attachment.file }}"
                >
                    <Button isDisabled="${attachment.file in [null]}" variant="primary" label="Upload attachment" />
                </Action>
            </Stack>
        </Dialog>
    </Stack>

    <Table data="$attachments" rowName="attachment" idKey="id" emptyLabel="No attachments uploaded yet.">
        <TableColumn key="name" field="name" header="File" />
        <TableColumn key="uploadedBy" i18n="requests.attachments.uploadedBy">
            <Stack direction="horizontal" gap="2">
                <Avatar src="$attachment.uploaded_by_avatar" name="$attachment.uploaded_by_name" size="sm" />
                <Text value="$attachment.uploaded_by_name" />
            </Stack>
        </TableColumn>
    </Table>
</longlink>
