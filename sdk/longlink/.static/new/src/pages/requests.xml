<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink version="v1" name="Requests" icon="clipboard-list">
    <Query id="requests" path="/api/requests" />
    <State id="draft" />

    <Stack direction="horizontal" justify="between" align="center" wrap="wrap" gap="3">
        <Stack>
            <Heading level="3" i18n="requests.title" />
            <Text as="p" color="secondary" i18n="requests.description" />
        </Stack>
        <Dialog title="New request" triggerLabel="New request" purpose="form">
            <Stack gap="3">
                <FormLayout>
                    <TextInput
                        i18n="requests.fields.text"
                        value="$draft.text"
                        isRequired="true"
                    />
                    <NumberInput i18n="requests.amount" units="CHF" value="$draft.amount" min="0" isRequired="true" />
                </FormLayout>
                <Action
                    action="/api/requests"
                    method="POST"
                    invalidate='${["requests"]}'
                    closeDialog="true"
                    json="${{ text: draft.text, amount: draft.amount }}"
                >
                    <Button isDisabled="${draft.text in ['']}" variant="primary" label="Create purchase request" />
                </Action>
            </Stack>
        </Dialog>
    </Stack>

    <Table data="$requests" rowName="request" idKey="id" emptyLabel="No purchase requests yet." hasHover="true">
        <TableColumn key="request" i18n="requests.table.request">
            <Stack gap="1">
                <Link to="/requests/${request.id}" label="$request.text" />
                <Text color="secondary" value="${`CHF ${request.amount}`}" hasTabularNumbers="true" />
            </Stack>
        </TableColumn>
    </Table>
</longlink>
