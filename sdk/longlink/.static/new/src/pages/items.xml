<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink version="0.3" name="Items" icon="package">
    <Query id="items" path="/api/items" />
    <State id="draft" />

    <Stack direction="horizontal" justify="between" align="center" wrap="wrap" gap="3">
        <Stack>
            <Heading level="3">Items</Heading>
            <Text as="p" color="secondary" value="Track catalog items and their supporting files." />
        </Stack>
        <Dialog title="New item" triggerLabel="New item" purpose="form">
            <Stack gap="3">
                <FormLayout>
                    <TextInput
                        label="Name"
                        value="$draft.name"
                        isRequired="true"
                    />
                    <NumberInput label="Price" units="CHF" value="$draft.price" min="0" isRequired="true" />
                </FormLayout>
                <Action
                    action="/api/items"
                    method="POST"
                    invalidate='${["items"]}'
                    closeDialog="true"
                    json="${{ name: draft.name, price: draft.price }}"
                >
                    <Button isDisabled="${draft.name === ''}" variant="primary" label="Create item" />
                </Action>
            </Stack>
        </Dialog>
    </Stack>

    <Table data="$items" idKey="id" density="compact" emptyLabel="No items yet." hasHover="true">
        <TableColumn key="item" header="Item">
            <Stack gap="1">
                <Link to="/items/${row.id}">
                    <Text value="$row.name" />
                </Link>
                <Text color="secondary" value="${`CHF ${row.price}`}" hasTabularNumbers="true" />
            </Stack>
        </TableColumn>
    </Table>
</longlink>
