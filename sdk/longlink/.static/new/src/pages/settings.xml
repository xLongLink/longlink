<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink version="0.3" name="Settings" icon="settings-2">
    <State id="profile" owner="Operations Desk" costCenter="OPS-100" note="Approve standard equipment within the monthly budget." />
    <State id="reviewer" name="Mira Tanner" initials="MT" badge="Approver" avatarUrl="https://api.dicebear.com/9.x/initials/svg?seed=Mira%20Tanner" />
    <State id="emailUpdates" value="${true}" />
    <State id="notifications" value="${true}" />
    <State id="budgetLimit" value="${2500}" />
    <State id="workflow" owner="manager" risk="medium" />

    <Stack>
        <Heading level="3">Application settings</Heading>
        <Text as="p" color="secondary" value="Configure application defaults with local XML state and Astryx form controls." />
    </Stack>

    <SideNav label="Settings sections">
        <SideNavItem value="application" icon="viewColumns" label="Application">
            <Stack gap="4">
                <Heading level="2">Application</Heading>
                <Text as="p" value="Edit the sample application's local owner, cost-center, and reviewer note fields." />
                <Card variant="muted">
                    <Stack direction="horizontal" align="center" gap="3">
                        <Avatar src="$reviewer.avatarUrl" name="$reviewer.name" alt="$reviewer.name" size="lg" />
                        <Stack gap="1">
                            <Text weight="semibold" value="Default reviewer" />
                            <Text color="secondary" value="$reviewer.initials" />
                        </Stack>
                        <Badge label="$reviewer.badge" variant="info" />
                    </Stack>
                </Card>
                <FormLayout>
                    <TextInput
                        label="Workflow owner"
                        description="This state is bound directly from XML."
                        value="$profile.owner"
                    />
                    <TextInput label="Cost center" value="$profile.costCenter" />
                    <TextArea
                        label="Approval note"
                        description="Visible to reviewers"
                        rows="4"
                        value="$profile.note"
                    />
                </FormLayout>
            </Stack>
        </SideNavItem>

        <SideNavItem value="preferences" icon="wrench" label="Preferences">
            <Stack gap="4">
                <Heading level="2">Preferences</Heading>
                <Text as="p" value="Toggle notification controls and adjust a slider-backed approval threshold." />
                <FormLayout>
                    <CheckboxInput
                        label="Email updates"
                        description="Send a digest when item status changes."
                        value="$emailUpdates"
                    />
                    <Switch
                        label="In-app notifications"
                        description="Show reminders for stale items."
                        value="$notifications"
                    />
                    <Slider label="Auto-approval limit" min="500" max="10000" step="500" value="$budgetLimit" />
                </FormLayout>
                <Text value="${`Auto-approve up to CHF ${budgetLimit.value}`}" />
            </Stack>
        </SideNavItem>

        <SideNavItem value="workflow" icon="arrowsUpDown" label="Workflow">
            <Stack gap="4">
                <Heading level="2">Workflow</Heading>
                <Text as="p" value="Use radio lists and selectors to model workflow defaults." />
                <FormLayout>
                    <RadioList label="Default approver" value="$workflow.owner">
                        <RadioListItem value="manager" label="Manager" />
                        <RadioListItem value="finance" label="Finance" />
                        <RadioListItem value="owner" label="Owner" />
                    </RadioList>
                    <Selector label="Risk level" value="$workflow.risk">
                        <SelectorOption value="low" label="Low" />
                        <SelectorOption value="medium" label="Medium" />
                        <SelectorOption value="high" label="High" />
                    </Selector>
                </FormLayout>
            </Stack>
        </SideNavItem>

    </SideNav>
</longlink>
