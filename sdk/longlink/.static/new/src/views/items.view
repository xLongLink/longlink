<view name="Invoices" icon="banknote">
    <State id="pages" value="${1}" />
    <Query id="items" path="/api/items?page=${pages.value}&page_size=8" />
    <State id="draft" status="draft" />
    <State id="createDialog" open="${false}" />

    <Stack gap="8">
        <Stack direction="horizontal" justify="between" align="center" wrap="wrap">
            <Heading level="1">Invoice approvals</Heading>
            <Dialog title="New Invoice" triggerLabel="New Invoice" isOpen="$createDialog.open" purpose="form">
                <TextInput label="Invoice number" value="$draft.name" />
                <NumberInput label="Amount (CHF)" value="$draft.price" min="0" />
                <Selector label="Status" value="$draft.status">
                    <Option value="draft" label="Draft" icon="logs" />
                    <Option value="pending" label="Pending" icon="clock" />
                    <Option value="approved" label="Approved" icon="check" />
                </Selector>
                <Button label="Create Invoice" variant="primary">
                    <Request
                        url="/api/items"
                        method="POST"
                        json="${{ name: draft.name, price: draft.price, status: draft.status }}"
                    />
                    <Patch state="items" invalidate="true" />
                    <Patch state="createDialog" value="${{ open: false }}" />
                </Button>
            </Dialog>
        </Stack>

        <Stack gap="1">
            <Table data="$items.items" idKey="id">
                <TableColumn field="name" header="Invoice">
                    <Stack gap="1">
                        <Stack direction="horizontal" align="center" gap="2" wrap="wrap">
                            <Link to="/items/${row.id}">$row.name</Link>
                            <Badge variant="neutral" if="${row.status === 'draft'}">Draft</Badge>
                            <Badge variant="warning" if="${row.status === 'pending'}">Pending</Badge>
                            <Badge variant="success" if="${row.status === 'approved'}">Approved</Badge>
                        </Stack>
                        <Stack direction="horizontal" align="center" gap="1">
                            <Text color="secondary" if="$row.created_at">
                                <Timestamp value="$row.created_at" format="date" />
                            </Text>
                            <Text color="secondary" if="$row.created_at">-</Text>
                            <Text color="secondary">
                                <Currency value="$row.price" currency="CHF" locale="de-CH" />
                            </Text>
                        </Stack>
                    </Stack>
                </TableColumn>
                <TableColumn field="created_by.name" header="Created by">
                    <Stack direction="horizontal" align="center" gap="3" if="$row.created_by">
                        <Avatar src="$row.created_by.avatar" name="$row.created_by.name" alt="$row.created_by.name" />
                        <Stack gap="0">
                            <Text value="$row.created_by.name" />
                            <Text color="secondary" value="$row.created_by.email" />
                        </Stack>
                    </Stack>
                    <Text color="secondary" if="${!row.created_by}">Unknown</Text>
                </TableColumn>
                <TableColumn field="approved_by.name" header="Approved by">
                    <Stack direction="horizontal" align="center" gap="3" if="$row.approved_by">
                        <Avatar
                            src="$row.approved_by.avatar"
                            name="$row.approved_by.name"
                            alt="$row.approved_by.name"
                        />
                        <Stack gap="0">
                            <Text value="$row.approved_by.name" />
                            <Text color="secondary" value="$row.approved_by.email" />
                        </Stack>
                    </Stack>
                    <Text color="secondary" if="${!row.approved_by}">—</Text>
                </TableColumn>
            </Table>
            <Stack direction="horizontal" gap="2" justify="between">
                <Button label="Previous" disabled="${pages.value === 1}">
                    <Patch state="pages" value="${{ value: pages.value - 1 }}" />
                    <Patch state="items" invalidate="true" />
                </Button>
                <Button label="Next" disabled="${items.total <= pages.value * 8}">
                    <Patch state="pages" value="${{ value: pages.value + 1 }}" />
                    <Patch state="items" invalidate="true" />
                </Button>
            </Stack>
        </Stack>
    </Stack>
</view>
