<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink name="Items" icon="box">
    <Query id="items" path="/api/items" />
    <State id="draft" />
    <State id="createDialog" open="${false}" />

    <Stack gap="8">
        <Stack direction="horizontal" justify="between" align="center" wrap="wrap">
            <Stack gap="1">
                <Heading level="1">Items</Heading>
                <Text color="secondary">Track catalog items and their supporting files.</Text>
            </Stack>
            <Dialog title="New item" triggerLabel="New item" isOpen="$createDialog.open" purpose="form">
                <TextInput label="Name" value="$draft.name" />
                <NumberInput label="Price" value="$draft.price" min="0" />
                <Button label="Create item" variant="primary">
                    <Request
                        url="/api/items"
                        method="POST"
                        json="${{ name: draft.name, price: draft.price }}"
                    />
                    <Patch state="items" invalidate="true" />
                    <Patch state="createDialog" value="${{ open: false }}" />
                </Button>
            </Dialog>
        </Stack>

        <Table data="$items" idKey="id">
            <TableColumn field="name" header="Item">
                <Stack gap="0">
                    <Link to="/items/${row.id}">
                        $row.name
                    </Link>
                    <Text color="secondary">${`CHF ${row.price}`}</Text>
                </Stack>
            </TableColumn>
        </Table>
    </Stack>
</longlink>
