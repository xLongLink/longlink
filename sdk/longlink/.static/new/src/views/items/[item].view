<longlink name="Invoices" icon="banknote">
    <Query id="item" path="/api/items/${params.item}" />
    <Query id="attachments" path="/api/items/${params.item}/attachments" />
    <State id="status" value="$item.status" />
    <State id="attachment" file="${null}" />
    <State id="uploadDialog" open="${false}" />
    <State id="preview" open="${false}" file="${null}" name="File" />

    <Stack gap="6">
        <Stack direction="horizontal" justify="between" align="start" wrap="wrap" gap="4">
            <Stack gap="2">
                <Heading level="1">$item.name</Heading>
                <Stack direction="horizontal" align="center" gap="1">
                    <Text color="secondary" if="$item.created_at">
                        <Timestamp value="$item.created_at" format="date" />
                    </Text>
                    <Text color="secondary" if="$item.created_at">-</Text>
                    <Text color="secondary">
                        <Currency value="$item.price" currency="CHF" locale="de-CH" />
                    </Text>
                </Stack>
            </Stack>
            <Dialog
                title="Upload Invoice Document"
                triggerLabel="Upload document"
                isOpen="$uploadDialog.open"
                purpose="form"
            >
                <FileInput label="Invoice document" value="$attachment.file" />
                <Button label="Upload document" variant="primary">
                    <Request
                        url="/api/items/${params.item}/attachments"
                        method="POST"
                        form="${{ file: attachment.file }}"
                    />
                    <Patch state="attachments" invalidate="true" />
                    <Patch state="uploadDialog" value="${{ open: false }}" />
                </Button>
            </Dialog>
        </Stack>

        <Divider />

        <Grid columns="3" gap="8">
            <GridSpan columns="2">
                <Stack gap="4">
                    <Table data="$attachments" idKey="id">
                        <TableColumn field="name" header="File">
                            <Link label="$row.name">
                                <Patch state="preview" value="${{ open: true, file: row.id, name: row.name }}" />
                            </Link>
                        </TableColumn>
                        <TableColumn field="size" header="Size" align="end">
                            <Text>${`${row.size} B`}</Text>
                        </TableColumn>
                    </Table>
                </Stack>
            </GridSpan>

            <Stack gap="4">
                <Selector label="Status" value="$status.value">
                    <Option value="draft" label="Draft" icon="logs" />
                    <Option value="pending" label="Pending" icon="clock" />
                    <Option value="approved" label="Approved" icon="check" />
                </Selector>
                <Button label="Save status" variant="primary" if="${status.value !== item.status}">
                    <Request url="/api/items/${params.item}/status" method="PATCH" json="${{ status: status.value }}" />
                    <Patch state="item" invalidate="true" />
                    <Patch state="status" invalidate="true" />
                </Button>
                <Stack gap="2" if="$item.approved_by">
                    <Text color="secondary">Approved by</Text>
                    <Stack direction="horizontal" align="center" gap="3">
                        <Avatar
                            src="$item.approved_by.avatar"
                            name="$item.approved_by.name"
                            alt="$item.approved_by.name"
                        />
                        <Stack gap="0">
                            <Text value="$item.approved_by.name" />
                            <Text color="secondary" value="$item.approved_by.email" />
                        </Stack>
                    </Stack>
                </Stack>
            </Stack>
        </Grid>

        <Dialog title="$preview.name" isOpen="$preview.open" purpose="info" width="90%" height="90vh">
            <FileViewer src="/api/items/${params.item}/attachments/${preview.file}" title="$preview.name" />
        </Dialog>
    </Stack>
</longlink>
