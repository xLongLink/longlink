<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="../types.xsd" />
  <xsd:complexType name="StackItemType" mixed="true">
    <xsd:sequence><xsd:any minOccurs="0" maxOccurs="unbounded" processContents="strict" /></xsd:sequence>
    <xsd:attribute name="size" type="StackItemSizeType" default="static" />
    <xsd:attribute name="isScrollable" type="xsd:boolean" default="false" />
    <xsd:attribute name="crossAlignSelf" type="BoxAlignType" />
    <xsd:attributeGroup ref="XmlRuntimeAttributes" />
  </xsd:complexType>
  <xsd:element name="StackItem" type="StackItemType">
    <xsd:annotation><xsd:documentation>Controls an individual child's size, overflow, or cross-axis alignment within a Stack.</xsd:documentation></xsd:annotation>
  </xsd:element>
</xsd:schema>
