<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="../types.xsd" />
  <xsd:complexType name="TableType">
    <xsd:sequence><xsd:element ref="TableColumn" minOccurs="1" maxOccurs="unbounded" /></xsd:sequence>
    <xsd:attribute name="data" type="NonBlankStringType" use="required" />
    <xsd:attribute name="idKey" type="FieldPathType" />
    <xsd:attribute name="emptyLabel" type="NonBlankStringType" default="No data" />
    <xsd:attribute name="density" type="TableDensityType" default="balanced" />
    <xsd:attribute name="dividers" type="TableDividersType" default="rows" />
    <xsd:attribute name="verticalAlign" type="TableVerticalAlignType" default="middle" />
    <xsd:attribute name="textOverflow" type="TableTextOverflowType" default="wrap" />
    <xsd:attribute name="isStriped" type="xsd:string" />
    <xsd:attribute name="hasHover" type="xsd:string" />
    <xsd:attributeGroup ref="XmlRuntimeAttributes" />
  </xsd:complexType>
  <xsd:complexType name="TableColumnType">
    <xsd:sequence><xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" /></xsd:sequence>
    <xsd:attribute name="key" type="NonBlankStringType" use="required" />
    <xsd:attribute name="field" type="FieldPathType" />
    <xsd:attribute name="header" type="xsd:string" use="required" />
    <xsd:attribute name="align" type="AlignType" default="start" />
    <xsd:attributeGroup ref="XmlRuntimeAttributes" />
  </xsd:complexType>
  <xsd:element name="Table" type="TableType">
    <xsd:annotation><xsd:documentation>Renders row data with the Astryx Table API.</xsd:documentation></xsd:annotation>
  </xsd:element>
  <xsd:element name="TableColumn" type="TableColumnType">
    <xsd:annotation><xsd:documentation>Defines a keyed Astryx column; field optionally selects a different row path and children form renderCell content.</xsd:documentation></xsd:annotation>
  </xsd:element>
</xsd:schema>
