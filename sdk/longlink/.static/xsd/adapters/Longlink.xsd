<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:complexType name="LonglinkType" mixed="true">
    <xsd:annotation>
      <xsd:documentation>Contains one LongLink XML View. View name and icon are metadata.</xsd:documentation>
    </xsd:annotation>
    <xsd:sequence>
      <xsd:any minOccurs="0" maxOccurs="unbounded" processContents="strict"/>
    </xsd:sequence>
    <xsd:attribute name="name" type="xsd:string"/>
    <xsd:attribute name="icon" type="xsd:string"/>
  </xsd:complexType>
  <xsd:element name="longlink" type="LonglinkType">
    <xsd:annotation>
      <xsd:documentation>Defines a LongLink XML View.</xsd:documentation>
      <xsd:appinfo source="urn:longlink:xsd-docs">
        <longlink:docs slug="longlink" category="Runtime" lastUpdated="2026-09-30" source="adapters/Longlink.xsd"/>
        <longlink:example>&lt;longlink name="Welcome" icon="layout-dashboard"&gt;
  &lt;Text&gt;Welcome&lt;/Text&gt;
&lt;/longlink&gt;</longlink:example>
      </xsd:appinfo>
    </xsd:annotation>
  </xsd:element>
</xsd:schema>
