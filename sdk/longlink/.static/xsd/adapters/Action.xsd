<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="../types.xsd" />
  <xsd:complexType name="ActionType">
    <xsd:sequence>
      <xsd:choice minOccurs="1" maxOccurs="unbounded">
        <xsd:element name="Request">
          <xsd:complexType>
            <xsd:attribute name="url" type="xsd:string" use="required" />
            <xsd:attribute name="method" type="ActionMethodType" use="required" />
            <xsd:attribute name="form" type="xsd:string" />
            <xsd:attribute name="json" type="xsd:string" />
            <xsd:attribute name="closeDialog" type="xsd:string" />
          </xsd:complexType>
        </xsd:element>
        <xsd:element name="Patch">
          <xsd:complexType>
            <xsd:attribute name="state" type="xsd:string" use="required" />
            <xsd:attribute name="value" type="xsd:string" />
            <xsd:attribute name="invalidate" type="xsd:boolean" fixed="true" />
          </xsd:complexType>
        </xsd:element>
      </xsd:choice>
      <xsd:element ref="Button" />
    </xsd:sequence>
    <xsd:attribute name="if" type="xsd:string" />
  </xsd:complexType>
  <xsd:element name="Action" type="ActionType">
    <xsd:annotation><xsd:documentation>Runs ordered request and state effects from its child button.</xsd:documentation></xsd:annotation>
  </xsd:element>
</xsd:schema>
