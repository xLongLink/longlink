<?xml version='1.0' encoding='UTF-8'?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:include schemaLocation="../types.xsd"/>
  <xsd:complexType name="FileInputType">
    <xsd:attribute name="label" type="NonBlankStringType" use="required"><xsd:annotation><xsd:documentation>Visible field label.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="value" type="xsd:string"><xsd:annotation><xsd:documentation>Selected file value.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="accept" type="xsd:string"><xsd:annotation><xsd:documentation>Accepted file types.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="description" type="xsd:string"><xsd:annotation><xsd:documentation>Supporting field text.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="placeholder" type="xsd:string"><xsd:annotation><xsd:documentation>Placeholder text.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="mode" type="FileInputModeType"><xsd:annotation><xsd:documentation>File picker mode: dropzone or input.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="maxSize" type="xsd:positiveInteger"><xsd:annotation><xsd:documentation>Maximum file size.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="maxFiles" type="xsd:positiveInteger"><xsd:annotation><xsd:documentation>Maximum number of files.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="width" type="xsd:string"><xsd:annotation><xsd:documentation>Control width.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="labelTooltip" type="xsd:string"><xsd:annotation><xsd:documentation>Tooltip for the label.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="disabledMessage" type="xsd:string"><xsd:annotation><xsd:documentation>Message shown when disabled.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="status" type="InputStatusType"><xsd:annotation><xsd:documentation>Validation status.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="statusMessage" type="xsd:string"><xsd:annotation><xsd:documentation>Validation status message.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="statusVariant" type="FieldStatusVariantType"><xsd:annotation><xsd:documentation>Presentation of the status message.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="isMultiple" type="xsd:string"><xsd:annotation><xsd:documentation>Allows multiple files.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="isDisabled" type="xsd:string"><xsd:annotation><xsd:documentation>Disables the field.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="isLoading" type="xsd:string"><xsd:annotation><xsd:documentation>Shows a loading state.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="isRequired" type="xsd:string"><xsd:annotation><xsd:documentation>Marks the field as required.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="isOptional" type="xsd:string"><xsd:annotation><xsd:documentation>Marks the field as optional.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attribute name="isLabelHidden" type="xsd:string"><xsd:annotation><xsd:documentation>Visually hides the label.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attributeGroup ref="XmlRuntimeAttributes"/>
  </xsd:complexType>
  <xsd:element name="FileInput" type="FileInputType">
    <xsd:annotation><xsd:documentation>FileInput provides file upload with optional drag-and-drop support. Use it for single or multiple file selection with built-in validation for file type, size, and count. Pair with validation status for upload feedback.</xsd:documentation><xsd:appinfo source="urn:longlink:xml-example"><longlink:example>&lt;FileInput label="Attachment" value="$form.file" accept=".pdf" /&gt;</longlink:example></xsd:appinfo></xsd:annotation>
  </xsd:element>
</xsd:schema>