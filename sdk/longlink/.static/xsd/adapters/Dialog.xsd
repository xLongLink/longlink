<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="../types.xsd" />
  <xsd:complexType name="DialogType">
    <xsd:sequence><xsd:any minOccurs="0" maxOccurs="unbounded" processContents="strict" /></xsd:sequence>
    <xsd:attribute name="title" type="NonBlankStringType" use="required" />
    <xsd:attribute name="subtitle" type="xsd:string" />
    <xsd:attribute name="isOpen" type="xsd:string" />
    <xsd:attribute name="triggerLabel" type="NonBlankStringType" />
    <xsd:attribute name="purpose" type="DialogPurposeType" default="info" />
    <xsd:attribute name="variant" type="DialogVariantType" default="standard" />
    <xsd:attribute name="width" type="xsd:string" />
    <xsd:attribute name="maxHeight" type="xsd:string" />
    <xsd:attribute name="padding" type="SpacingType" />
    <xsd:attributeGroup ref="XmlRuntimeAttributes" />
  </xsd:complexType>
  <xsd:element name="Dialog" type="DialogType">
    <xsd:annotation><xsd:documentation>Renders a controlled Astryx dialog with an optional trigger.</xsd:documentation></xsd:annotation>
  </xsd:element>
</xsd:schema>
