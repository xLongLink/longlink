<?xml version='1.0' encoding='UTF-8'?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:include schemaLocation="../types.xsd"/>
  <xsd:complexType name="StateType">
    <xsd:attribute name="id" type="xsd:string" use="required"><xsd:annotation><xsd:documentation>Literal runtime state identifier.</xsd:documentation></xsd:annotation></xsd:attribute>
    <xsd:attributeGroup ref="XmlRuntimeAttributes"/>
    <xsd:anyAttribute processContents="lax"/>
  </xsd:complexType>
  <xsd:element name="State" type="StateType">
    <xsd:annotation><xsd:documentation>Use State for information that changes while someone uses a page, such as form entries or selected options.</xsd:documentation><xsd:appinfo source="urn:longlink:xml-example"><longlink:example>&lt;State id="form" name="" active="true" /&gt;

&lt;TextInput label="Name" value="$form.name" /&gt;</longlink:example></xsd:appinfo></xsd:annotation>
  </xsd:element>
</xsd:schema>