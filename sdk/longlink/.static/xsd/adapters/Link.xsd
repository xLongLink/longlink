<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:complexType name="LinkType" mixed="true">
    <xsd:group ref="ActionEffects" minOccurs="0" maxOccurs="unbounded"/>
    <xsd:attribute name="href" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>External or absolute URL.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="to" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Solution-relative navigation destination.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="label" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Link text. Required when the Link contains effects.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attributeGroup ref="XmlRuntimeAttributes"/>
  </xsd:complexType>
  <xsd:element name="Link" type="LinkType">
    <xsd:annotation>
      <xsd:documentation>A styled navigation link. With label and child effects, it runs them in order before navigating and behaves like a link-styled button.</xsd:documentation>
      <xsd:appinfo source="urn:longlink:xml-example">
        <longlink:docs slug="link" category="Actions" lastUpdated="2026-07-21"/>
        <longlink:example>&lt;view&gt;
  &lt;State id="order" number="ORD-001" /&gt;
  &lt;Link to="/orders/${order.number}"&gt;Open order&lt;/Link&gt;

  &lt;Link label="Create and open order" to="/orders/${order.number}"&gt;
    &lt;Request method="POST" url="/api/orders" json="${order}" /&gt;
  &lt;/Link&gt;
&lt;/view&gt;</longlink:example>
      </xsd:appinfo>
    </xsd:annotation>
  </xsd:element>
</xsd:schema>
