<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:complexType name="CurrencyType">
    <xsd:attribute name="value" type="xsd:string" use="required">
      <xsd:annotation>
        <xsd:documentation>Finite numeric amount or an expression resolving to a number.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="currency" type="NonBlankStringType" use="required">
      <xsd:annotation>
        <xsd:documentation>Three-letter uppercase currency code, such as CHF, EUR, or USD.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="locale" type="NonBlankStringType">
      <xsd:annotation>
        <xsd:documentation>BCP 47 locale identifier, such as de-CH. Defaults to the viewer's locale.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attributeGroup ref="XmlRuntimeAttributes"/>
  </xsd:complexType>
  <xsd:element name="Currency" type="CurrencyType">
    <xsd:annotation>
      <xsd:documentation>Displays a numeric amount with its currency code, locale-specific grouping, and standard currency fraction digits. Use locale="de-CH" for Swiss formatting such as CHF 1’275.50. Keep the underlying amount numeric and use Text for surrounding typography.</xsd:documentation>
      <xsd:appinfo source="urn:longlink:xml-example">
        <longlink:docs slug="currency" category="Display" lastUpdated="2026-09-30"/>
        <longlink:example>&lt;view&gt;
  &lt;State id="item" price="1275.50" /&gt;
  &lt;Text color="secondary"&gt;
    &lt;Currency value="$item.price" currency="CHF" locale="de-CH" /&gt;
  &lt;/Text&gt;
&lt;/view&gt;</longlink:example>
      </xsd:appinfo>
    </xsd:annotation>
  </xsd:element>
</xsd:schema>
