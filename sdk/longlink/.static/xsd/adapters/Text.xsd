<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="../types.xsd" />
  <xsd:complexType name="TextType" mixed="true">
    <xsd:sequence><xsd:any minOccurs="0" maxOccurs="unbounded" processContents="strict" /></xsd:sequence>
    <xsd:attributeGroup ref="XmlRuntimeAttributes" />
  </xsd:complexType>
  <xsd:complexType name="InlineTextType" mixed="true">
    <xsd:sequence><xsd:any minOccurs="0" maxOccurs="unbounded" processContents="strict" /></xsd:sequence>
  </xsd:complexType>
  <xsd:element name="Text" type="TextType">
    <xsd:annotation><xsd:documentation>Renders text with standard b and i inline elements.</xsd:documentation></xsd:annotation>
  </xsd:element>
  <xsd:element name="b" type="InlineTextType" />
  <xsd:element name="i" type="InlineTextType" />
</xsd:schema>
