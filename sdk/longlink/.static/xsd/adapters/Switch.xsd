<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="../types.xsd" />
  <xsd:complexType name="SwitchType">
    <xsd:attribute name="label" type="NonBlankStringType" use="required" />
    <xsd:attribute name="value" type="xsd:string" use="optional" />
    <xsd:attribute name="description" type="xsd:string" use="optional" />
    <xsd:attribute name="htmlName" type="xsd:string" use="optional" />
    <xsd:attribute name="width" type="xsd:string" use="optional" />
    <xsd:attribute name="size" type="CompactSizeType" use="optional" />
    <xsd:attribute name="labelTooltip" type="xsd:string" use="optional" />
    <xsd:attribute name="disabledMessage" type="xsd:string" use="optional" />
    <xsd:attribute name="labelPosition" type="SwitchLabelPositionType" use="optional" default="end" />
    <xsd:attribute name="labelSpacing" type="SwitchLabelSpacingType" use="optional" default="hug" />
    <xsd:attribute name="status" type="InputStatusType" use="optional" />
    <xsd:attribute name="statusMessage" type="xsd:string" use="optional" />
    <xsd:attribute name="isDisabled" type="xsd:string" use="optional" />
    <xsd:attribute name="isRequired" type="xsd:string" use="optional" />
    <xsd:attribute name="isOptional" type="xsd:string" use="optional" />
    <xsd:attribute name="isLabelHidden" type="xsd:string" use="optional" />
    <xsd:attribute name="isLoading" type="xsd:boolean" use="optional" />
    <xsd:attributeGroup ref="XmlRuntimeAttributes" />
  </xsd:complexType>
  <xsd:element name="Switch" type="SwitchType">
    <xsd:annotation><xsd:documentation>Collects an on or off setting with Astryx Switch.</xsd:documentation></xsd:annotation>
  </xsd:element>
</xsd:schema>
