<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="../types.xsd" />
  <xsd:complexType name="TextInputType">
    <xsd:attribute name="label" type="NonBlankStringType" use="required" />
    <xsd:attribute name="value" type="xsd:string" />
    <xsd:attribute name="type" type="TextInputKindType" default="text" />
    <xsd:attribute name="description" type="xsd:string" />
    <xsd:attribute name="isDisabled" type="xsd:string" />
    <xsd:attribute name="isRequired" type="xsd:string" />
    <xsd:attributeGroup ref="XmlRuntimeAttributes" />
  </xsd:complexType>
  <xsd:element name="TextInput" type="TextInputType">
    <xsd:annotation><xsd:documentation>Collects text with an accessible Astryx field.</xsd:documentation></xsd:annotation>
  </xsd:element>
</xsd:schema>
