<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:include schemaLocation="../types.xsd" />
  <xsd:complexType name="GridType">
    <xsd:sequence><xsd:any minOccurs="0" maxOccurs="unbounded" processContents="lax" /></xsd:sequence>
    <xsd:attribute name="columns" type="xsd:positiveInteger" />
    <xsd:attribute name="minColumnWidth" type="PositiveDecimalType" />
    <xsd:attribute name="maxColumns" type="xsd:positiveInteger" />
    <xsd:attribute name="repeat" type="GridRepeatType" default="fill" />
    <xsd:attribute name="gap" type="SpacingType" />
    <xsd:attribute name="rowGap" type="SpacingType" />
    <xsd:attribute name="rowHeight" type="PositiveDecimalType" />
    <xsd:attribute name="columnGap" type="SpacingType" />
    <xsd:attribute name="align" type="BoxAlignType" default="stretch" />
    <xsd:attribute name="justify" type="BoxAlignType" default="stretch" />
    <xsd:attribute name="width" type="xsd:string" />
    <xsd:attribute name="height" type="xsd:string" />
    <xsd:attribute name="maxWidth" type="xsd:string" />
    <xsd:attribute name="minHeight" type="xsd:string" />
    <xsd:attributeGroup ref="XmlRuntimeAttributes" />
  </xsd:complexType>
  <xsd:element name="Grid" type="GridType">
    <xsd:annotation><xsd:documentation>Arranges XML children in an Astryx grid. Use columns for a fixed grid, or minColumnWidth with optional maxColumns and repeat for a responsive grid.</xsd:documentation></xsd:annotation>
  </xsd:element>
</xsd:schema>
