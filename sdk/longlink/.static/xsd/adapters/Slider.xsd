<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:include schemaLocation="../types.xsd"/>
  <xsd:complexType name="SliderType">
    <xsd:attribute name="label" type="NonBlankStringType" use="required">
      <xsd:annotation>
        <xsd:documentation>Visible field label.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="value" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Numeric field value.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="description" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Supporting field text.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="htmlName" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>HTML form field name.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="min" type="xsd:decimal">
      <xsd:annotation>
        <xsd:documentation>Minimum allowed value.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="max" type="xsd:decimal">
      <xsd:annotation>
        <xsd:documentation>Maximum allowed value.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="step" type="PositiveDecimalType">
      <xsd:annotation>
        <xsd:documentation>Increment between allowed values.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="orientation" type="OrientationType">
      <xsd:annotation>
        <xsd:documentation>Slider orientation.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="valueDisplay" type="SliderValueDisplayType">
      <xsd:annotation>
        <xsd:documentation>How to display the value.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="minStepsBetweenThumbs" type="xsd:nonNegativeInteger">
      <xsd:annotation>
        <xsd:documentation>Minimum increments between thumbs.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="width" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Control width.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="labelTooltip" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Tooltip for the label.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="disabledMessage" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Message shown when disabled.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="status" type="InputStatusType">
      <xsd:annotation>
        <xsd:documentation>Validation status.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="statusMessage" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Validation status message.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="isDisabled" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Disables the field.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="isRequired" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Marks the field as required.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="isOptional" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Marks the field as optional.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attribute name="isLabelHidden" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Visually hides the label.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
    <xsd:attributeGroup ref="XmlRuntimeAttributes"/>
  </xsd:complexType>
  <xsd:element name="Slider" type="SliderType">
    <xsd:annotation>
      <xsd:documentation>A draggable control for selecting a numeric value or range within defined bounds. Supports single value and range selection, tick marks, custom value formatting, and vertical orientation. Use it when users need to explore a continuous range, such as volume, price, or percentage.</xsd:documentation>
      <xsd:appinfo source="urn:longlink:xml-example">
        <longlink:docs slug="slider" category="Form" lastUpdated="2026-07-21" source="adapters/Slider.xsd"/>
        <longlink:example>&lt;Slider label="Budget" value="$form.budget" min="500" max="10000" step="500" /&gt;</longlink:example>
      </xsd:appinfo>
    </xsd:annotation>
  </xsd:element>
</xsd:schema>
