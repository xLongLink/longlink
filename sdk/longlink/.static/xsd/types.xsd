<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:attributeGroup name="XmlRuntimeAttributes">
    <xsd:annotation>
      <xsd:documentation>XML runtime attributes. Every other attribute must match the corresponding Astryx component prop.</xsd:documentation>
    </xsd:annotation>
    <xsd:attribute name="if" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Conditional rendering expression.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
  </xsd:attributeGroup>
  <xsd:simpleType name="NonBlankStringType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value=".*[^\s].*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="FieldPathType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[^.\s]+(\.[^.\s]+)*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="PositiveDecimalType">
    <xsd:restriction base="xsd:decimal">
      <xsd:minExclusive value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="FieldStatusVariantType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="attached"/>
      <xsd:enumeration value="detached"/>
      <xsd:enumeration value="tooltip"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="LayerPlacementType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="above"/>
      <xsd:enumeration value="below"/>
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="end"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SelectorVariantType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="input"/>
      <xsd:enumeration value="ghost"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ActionMethodType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="DELETE"/>
      <xsd:enumeration value="GET"/>
      <xsd:enumeration value="PATCH"/>
      <xsd:enumeration value="POST"/>
      <xsd:enumeration value="PUT"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SizeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="sm"/>
      <xsd:enumeration value="md"/>
      <xsd:enumeration value="lg"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="CompactSizeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="sm"/>
      <xsd:enumeration value="md"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="OrientationType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="horizontal"/>
      <xsd:enumeration value="vertical"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="InputStatusType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="warning"/>
      <xsd:enumeration value="error"/>
      <xsd:enumeration value="success"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ButtonVariantType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="primary"/>
      <xsd:enumeration value="secondary"/>
      <xsd:enumeration value="ghost"/>
      <xsd:enumeration value="destructive"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="DialogPurposeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="required"/>
      <xsd:enumeration value="form"/>
      <xsd:enumeration value="info"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="FileInputModeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="dropzone"/>
      <xsd:enumeration value="input"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="GridRepeatType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="fill"/>
      <xsd:enumeration value="fit"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="GridSpanColumnsType">
    <xsd:union memberTypes="xsd:positiveInteger">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="full"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:union>
  </xsd:simpleType>
  <xsd:simpleType name="StackItemSizeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="static"/>
      <xsd:enumeration value="fill"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="AlignType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="center"/>
      <xsd:enumeration value="end"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="BoxAlignType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="center"/>
      <xsd:enumeration value="end"/>
      <xsd:enumeration value="stretch"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="HeadingLevelType">
    <xsd:restriction base="xsd:integer">
      <xsd:minInclusive value="1"/>
      <xsd:maxInclusive value="6"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SliderValueDisplayType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="tooltip"/>
      <xsd:enumeration value="text"/>
      <xsd:enumeration value="none"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="StackJustifyType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="center"/>
      <xsd:enumeration value="end"/>
      <xsd:enumeration value="between"/>
      <xsd:enumeration value="around"/>
      <xsd:enumeration value="evenly"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="StackWrapType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="nowrap"/>
      <xsd:enumeration value="wrap"/>
      <xsd:enumeration value="wrap-reverse"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SwitchLabelPositionType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="end"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TabLayoutType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="hug"/>
      <xsd:enumeration value="fill"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TypographyType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="body"/>
      <xsd:enumeration value="large"/>
      <xsd:enumeration value="label"/>
      <xsd:enumeration value="supporting"/>
      <xsd:enumeration value="code"/>
      <xsd:enumeration value="display-1"/>
      <xsd:enumeration value="display-2"/>
      <xsd:enumeration value="display-3"/>
      <xsd:enumeration value="inherit"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="FontWeightType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="normal"/>
      <xsd:enumeration value="medium"/>
      <xsd:enumeration value="semibold"/>
      <xsd:enumeration value="bold"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TextElementType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="span"/>
      <xsd:enumeration value="p"/>
      <xsd:enumeration value="div"/>
      <xsd:enumeration value="label"/>
      <xsd:enumeration value="h1"/>
      <xsd:enumeration value="h2"/>
      <xsd:enumeration value="h3"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TextSizeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="4xs"/>
      <xsd:enumeration value="3xs"/>
      <xsd:enumeration value="2xs"/>
      <xsd:enumeration value="xsm"/>
      <xsd:enumeration value="sm"/>
      <xsd:enumeration value="base"/>
      <xsd:enumeration value="lg"/>
      <xsd:enumeration value="xl"/>
      <xsd:enumeration value="2xl"/>
      <xsd:enumeration value="3xl"/>
      <xsd:enumeration value="4xl"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TextInputKindType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="text"/>
      <xsd:enumeration value="password"/>
      <xsd:enumeration value="email"/>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
