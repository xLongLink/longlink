<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:attributeGroup name="XmlRuntimeAttributes">
    <xsd:attribute name="if" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Conditional rendering expression.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
  </xsd:attributeGroup>
  <xsd:simpleType name="NonBlankStringType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value=".*[^\s].*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="FieldPathType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[^.\s]+(\.[^.\s]+)*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="PositiveDecimalType">
    <xsd:restriction base="xsd:decimal">
      <xsd:minExclusive value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SpacingType">
    <xsd:restriction base="xsd:decimal">
      <xsd:enumeration value="0"/>
      <xsd:enumeration value="0.5"/>
      <xsd:enumeration value="1"/>
      <xsd:enumeration value="1.5"/>
      <xsd:enumeration value="2"/>
      <xsd:enumeration value="3"/>
      <xsd:enumeration value="4"/>
      <xsd:enumeration value="5"/>
      <xsd:enumeration value="6"/>
      <xsd:enumeration value="8"/>
      <xsd:enumeration value="10"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ActionMethodType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="DELETE"/>
      <xsd:enumeration value="GET"/>
      <xsd:enumeration value="PATCH"/>
      <xsd:enumeration value="POST"/>
      <xsd:enumeration value="PUT"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="OrientationType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="horizontal"/>
      <xsd:enumeration value="vertical"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ButtonVariantType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="primary"/>
      <xsd:enumeration value="secondary"/>
      <xsd:enumeration value="ghost"/>
      <xsd:enumeration value="destructive"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="DialogPurposeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="required"/>
      <xsd:enumeration value="form"/>
      <xsd:enumeration value="info"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="GridRepeatType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="fill"/>
      <xsd:enumeration value="fit"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="GridSpanColumnsType">
    <xsd:union memberTypes="xsd:positiveInteger">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="full"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:union>
  </xsd:simpleType>
  <xsd:simpleType name="StackItemSizeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="static"/>
      <xsd:enumeration value="fill"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="BoxAlignType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="center"/>
      <xsd:enumeration value="end"/>
      <xsd:enumeration value="stretch"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="HeadingLevelType">
    <xsd:restriction base="xsd:integer">
      <xsd:minInclusive value="1"/>
      <xsd:maxInclusive value="6"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="StackJustifyType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="center"/>
      <xsd:enumeration value="end"/>
      <xsd:enumeration value="between"/>
      <xsd:enumeration value="around"/>
      <xsd:enumeration value="evenly"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="StackWrapType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="nowrap"/>
      <xsd:enumeration value="wrap"/>
      <xsd:enumeration value="wrap-reverse"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TextColorType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="primary"/>
      <xsd:enumeration value="secondary"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TextInputKindType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="text"/>
      <xsd:enumeration value="password"/>
      <xsd:enumeration value="email"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="IconNameType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="close"/>
      <xsd:enumeration value="chevronDown"/>
      <xsd:enumeration value="chevronLeft"/>
      <xsd:enumeration value="chevronRight"/>
      <xsd:enumeration value="chevronsLeft"/>
      <xsd:enumeration value="chevronsRight"/>
      <xsd:enumeration value="check"/>
      <xsd:enumeration value="success"/>
      <xsd:enumeration value="error"/>
      <xsd:enumeration value="warning"/>
      <xsd:enumeration value="info"/>
      <xsd:enumeration value="calendar"/>
      <xsd:enumeration value="clock"/>
      <xsd:enumeration value="externalLink"/>
      <xsd:enumeration value="menu"/>
      <xsd:enumeration value="moreHorizontal"/>
      <xsd:enumeration value="search"/>
      <xsd:enumeration value="arrowUp"/>
      <xsd:enumeration value="arrowDown"/>
      <xsd:enumeration value="arrowsUpDown"/>
      <xsd:enumeration value="funnel"/>
      <xsd:enumeration value="eyeSlash"/>
      <xsd:enumeration value="viewColumns"/>
      <xsd:enumeration value="copy"/>
      <xsd:enumeration value="checkDouble"/>
      <xsd:enumeration value="wrench"/>
      <xsd:enumeration value="stop"/>
      <xsd:enumeration value="microphone"/>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
