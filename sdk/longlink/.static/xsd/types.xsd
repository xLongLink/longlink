<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:longlink="urn:longlink:xsd-docs">
  <xsd:attributeGroup name="XmlRuntimeAttributes">
    <xsd:attribute name="if" type="xsd:string">
      <xsd:annotation>
        <xsd:documentation>Conditional rendering expression.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
  </xsd:attributeGroup>
  <xsd:group name="ActionEffects">
    <xsd:choice>
      <xsd:element name="Request">
        <xsd:annotation>
          <xsd:documentation>Sends a solution-relative HTTP request. Use either form for multipart data or json for a JSON payload, never both. GET requests cannot send payloads. A failed request stops the remaining effects and navigation.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:attribute name="url" type="xsd:string" use="required">
            <xsd:annotation>
              <xsd:documentation>Solution-relative request URL.</xsd:documentation>
            </xsd:annotation>
          </xsd:attribute>
          <xsd:attribute name="method" type="ActionMethodType" use="required">
            <xsd:annotation>
              <xsd:documentation>HTTP request method.</xsd:documentation>
            </xsd:annotation>
          </xsd:attribute>
          <xsd:attribute name="form" type="xsd:string">
            <xsd:annotation><xsd:documentation>Object expression sent as multipart form data, including file uploads.</xsd:documentation></xsd:annotation>
          </xsd:attribute>
          <xsd:attribute name="json" type="xsd:string">
            <xsd:annotation><xsd:documentation>Expression sent as the JSON request body.</xsd:documentation></xsd:annotation>
          </xsd:attribute>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="Patch">
        <xsd:annotation>
          <xsd:documentation>Updates declared State properties or invalidates a State or Query. Use a literal state identifier and specify exactly one of value or invalidate="true".</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:attribute name="state" type="xsd:string" use="required">
            <xsd:annotation>
              <xsd:documentation>Literal State identifier to patch, or State/Query identifier to invalidate.</xsd:documentation>
            </xsd:annotation>
          </xsd:attribute>
          <xsd:attribute name="value" type="xsd:string">
            <xsd:annotation>
              <xsd:documentation>Object expression containing declared State properties to update. Specify exactly one of value or invalidate="true".</xsd:documentation>
            </xsd:annotation>
          </xsd:attribute>
          <xsd:attribute name="invalidate" type="xsd:boolean" fixed="true">
            <xsd:annotation>
              <xsd:documentation>Reinitializes the referenced State or refetches the referenced Query. Specify exactly one of value or invalidate="true".</xsd:documentation>
            </xsd:annotation>
          </xsd:attribute>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="Validate">
        <xsd:annotation>
          <xsd:documentation>Validates and normalizes an object before the following effects run. Field rules support string and number types; validation failures stop the remaining effects and navigation.</xsd:documentation>
        </xsd:annotation>
        <xsd:complexType>
          <xsd:attribute name="value" type="xsd:string" use="required">
            <xsd:annotation><xsd:documentation>Object expression to validate and normalize before a request.</xsd:documentation></xsd:annotation>
          </xsd:attribute>
          <xsd:attribute name="rules" type="xsd:string" use="required">
            <xsd:annotation><xsd:documentation>Declarative field validation rules expression.</xsd:documentation></xsd:annotation>
          </xsd:attribute>
        </xsd:complexType>
      </xsd:element>
    </xsd:choice>
  </xsd:group>
  <xsd:simpleType name="NonBlankStringType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value=".*[^\s].*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="FieldPathType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[^.\s]+(\.[^.\s]+)*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="PositiveDecimalType">
    <xsd:restriction base="xsd:decimal">
      <xsd:minExclusive value="0"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SpacingType">
    <xsd:restriction base="xsd:decimal">
      <xsd:enumeration value="0"/>
      <xsd:enumeration value="0.5"/>
      <xsd:enumeration value="1"/>
      <xsd:enumeration value="1.5"/>
      <xsd:enumeration value="2"/>
      <xsd:enumeration value="3"/>
      <xsd:enumeration value="4"/>
      <xsd:enumeration value="5"/>
      <xsd:enumeration value="6"/>
      <xsd:enumeration value="8"/>
      <xsd:enumeration value="10"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ActionMethodType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="DELETE"/>
      <xsd:enumeration value="GET"/>
      <xsd:enumeration value="PATCH"/>
      <xsd:enumeration value="POST"/>
      <xsd:enumeration value="PUT"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="OrientationType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="horizontal"/>
      <xsd:enumeration value="vertical"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="ButtonVariantType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="primary"/>
      <xsd:enumeration value="secondary"/>
      <xsd:enumeration value="ghost"/>
      <xsd:enumeration value="destructive"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="DialogPurposeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="required"/>
      <xsd:enumeration value="form"/>
      <xsd:enumeration value="info"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="GridRepeatType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="fill"/>
      <xsd:enumeration value="fit"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="GridSpanColumnsType">
    <xsd:union memberTypes="xsd:positiveInteger">
      <xsd:simpleType>
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="full"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:union>
  </xsd:simpleType>
  <xsd:simpleType name="StackItemSizeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="static"/>
      <xsd:enumeration value="fill"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="BoxAlignType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="center"/>
      <xsd:enumeration value="end"/>
      <xsd:enumeration value="stretch"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="HeadingLevelType">
    <xsd:restriction base="xsd:integer">
      <xsd:minInclusive value="1"/>
      <xsd:maxInclusive value="6"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="StackJustifyType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="center"/>
      <xsd:enumeration value="end"/>
      <xsd:enumeration value="between"/>
      <xsd:enumeration value="around"/>
      <xsd:enumeration value="evenly"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="StackWrapType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="nowrap"/>
      <xsd:enumeration value="wrap"/>
      <xsd:enumeration value="wrap-reverse"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TableColumnAlignType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="start"/>
      <xsd:enumeration value="center"/>
      <xsd:enumeration value="end"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TextColorType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="primary"/>
      <xsd:enumeration value="secondary"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TextStyleType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="body"/>
      <xsd:enumeration value="large"/>
      <xsd:enumeration value="label"/>
      <xsd:enumeration value="supporting"/>
      <xsd:enumeration value="code"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="TextInputKindType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="text"/>
      <xsd:enumeration value="password"/>
      <xsd:enumeration value="email"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="IconNameType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="close"/>
      <xsd:enumeration value="chevronDown"/>
      <xsd:enumeration value="chevronLeft"/>
      <xsd:enumeration value="chevronRight"/>
      <xsd:enumeration value="chevronsLeft"/>
      <xsd:enumeration value="chevronsRight"/>
      <xsd:enumeration value="check"/>
      <xsd:enumeration value="success"/>
      <xsd:enumeration value="error"/>
      <xsd:enumeration value="warning"/>
      <xsd:enumeration value="info"/>
      <xsd:enumeration value="calendar"/>
      <xsd:enumeration value="clock"/>
      <xsd:enumeration value="externalLink"/>
      <xsd:enumeration value="menu"/>
      <xsd:enumeration value="moreHorizontal"/>
      <xsd:enumeration value="search"/>
      <xsd:enumeration value="arrowUp"/>
      <xsd:enumeration value="arrowDown"/>
      <xsd:enumeration value="arrowsUpDown"/>
      <xsd:enumeration value="funnel"/>
      <xsd:enumeration value="eyeSlash"/>
      <xsd:enumeration value="viewColumns"/>
      <xsd:enumeration value="copy"/>
      <xsd:enumeration value="checkDouble"/>
      <xsd:enumeration value="wrench"/>
      <xsd:enumeration value="stop"/>
      <xsd:enumeration value="microphone"/>
      <xsd:enumeration value="logs"/>
      <xsd:enumeration value="trash"/>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
