<view name="Organization Settings" icon="settings2">
    <Query
        id="membership"
        path="/api/v1/organizations/slug/${params.organization}"
    />
    <Query
        id="details"
        path="/api/v1/organizations/${membership.organization.id}"
    />
    <Query
        id="storage"
        path="/api/v1/organizations/${membership.organization.id}/storage"
    />
    <Query
        id="solutions"
        path="/api/v1/organizations/${membership.organization.id}/solutions"
    />
    <State id="invitation" email="" role="write" />
    <State id="invitationDialog" open="${false}" />
    <State id="memberMenu" item="${null}" role="read" open="${false}" />
    <State
        id="solutionMenu"
        envs="${{}}"
        item="${null}"
        deleteOpen="${false}"
        logsOpen="${false}"
        open="${false}"
        removed="${{}}"
        reviewing="${false}"
    />
    <State
        id="createSolution"
        description=""
        envs="${{}}"
        image=""
        inspecting="${false}"
        name=""
        open="${false}"
        step="${0}"
    />
    <Query
        id="solutionLogs"
        if="$solutionMenu.logsOpen"
        path="/api/v1/solutions/${solutionMenu.item.id}/logs"
    />
    <Query
        id="createSolutionMetadata"
        if="${createSolution.open && createSolution.inspecting}"
        path="/api/v1/image?image=${createSolution.image}"
    />
    <Query
        id="updateCandidate"
        if="$solutionMenu.reviewing"
        path="/api/v1/solutions/${solutionMenu.item.id}/update"
    />
    <Invalidate
        if="$solutionMenu.reviewing"
        query="updateCandidate"
        state="solutionMenu"
        value="${{ open: true, reviewing: false }}"
    />

    <Stack gap="8">
        <Stack direction="horizontal" gap="3" align="center">
            <Avatar shape="rounded" name="$details.organization.name" />
            <Stack gap="0">
                <Heading level="4" accessibilityLevel="1">
                    $details.organization.name
                </Heading>
                <Text type="supporting">Organization</Text>
            </Stack>
        </Stack>

        <Menu>
            <MenuSection title="Settings" isHeaderHidden="true">
                <MenuItem label="Organization" icon="building2">
                    <Stack gap="4">
                        <Stack gap="1">
                            <Heading level="2">Organization</Heading>
                            <Text color="secondary">Review storage usage.</Text>
                        </Stack>
                        <Divider />
                        <ProgressBar
                            if="$storage"
                            label="Storage"
                            value="$storage.space_used"
                            max="$storage.quota_bytes"
                        />
                    </Stack>
                </MenuItem>
                <MenuSubSection label="People" icon="users">
                    <MenuItem label="Members">
                        <Stack gap="4">
                            <Stack gap="1">
                                <Heading level="2">Members</Heading>
                                <Text color="secondary">
                                    Manage the people in this organization.
                                </Text>
                            </Stack>
                            <Divider />
                            <Table
                                data="$details.members"
                                idKey="user.id"
                                hasHover="true"
                            >
                                <TableColumn field="user.name" header="User">
                                    <Stack
                                        direction="horizontal"
                                        gap="3"
                                        align="center"
                                    >
                                        <Avatar
                                            name="$row.user.name"
                                            src="$row.user.avatar"
                                        />
                                        <Stack align="start">
                                            <Stack
                                                direction="horizontal"
                                                gap="1"
                                                align="center"
                                            >
                                                <Text>$row.user.name</Text>
                                                <Badge>$row.role</Badge>
                                            </Stack>
                                            <Text type="supporting">
                                                $row.user.email
                                            </Text>
                                        </Stack>
                                    </Stack>
                                </TableColumn>
                                <TableColumn
                                    if="${membership.role === 'admin' || membership.role === 'owner'}"
                                    field="user.id"
                                    header="Actions"
                                    align="end"
                                >
                                    <MoreMenu value="$memberMenu">
                                        <Option
                                            if="${row.role !== 'read'}"
                                            value="${{ item: row, role: 'read', open: true }}"
                                            label="Set as Read"
                                        />
                                        <Option
                                            if="${row.role !== 'write'}"
                                            value="${{ item: row, role: 'write', open: true }}"
                                            label="Set as Write"
                                        />
                                        <Option
                                            if="${row.role !== 'maintain'}"
                                            value="${{ item: row, role: 'maintain', open: true }}"
                                            label="Set as Maintain"
                                        />
                                        <Option
                                            if="${row.role !== 'admin'}"
                                            value="${{ item: row, role: 'admin', open: true }}"
                                            label="Set as Admin"
                                        />
                                    </MoreMenu>
                                </TableColumn>
                            </Table>
                        </Stack>
                    </MenuItem>
                    <MenuItem label="Invitations">
                        <Stack gap="4">
                            <Stack
                                direction="horizontal"
                                justify="between"
                                align="center"
                                wrap="wrap"
                            >
                                <Stack gap="1">
                                    <Heading level="2">Invitations</Heading>
                                    <Text color="secondary">
                                        Send an invitation to join this
                                        organization.
                                    </Text>
                                </Stack>
                                <Dialog
                                    if="${membership.role === 'maintain' || membership.role === 'admin' || membership.role === 'owner'}"
                                    title="Invite user"
                                    subtitle="Send an invitation to join this organization."
                                    triggerLabel="Invite"
                                    isOpen="$invitationDialog.open"
                                    purpose="form"
                                >
                                    <Stack gap="3">
                                        <TextInput
                                            label="Email"
                                            value="$invitation.email"
                                            placeholder="user@example.com"
                                            isRequired="true"
                                        />
                                        <Selector
                                            label="Role"
                                            value="$invitation.role"
                                        >
                                            <Option value="read" />
                                            <Option value="write" />
                                            <Option value="maintain" />
                                            <Option value="admin" />
                                        </Selector>
                                        <Button
                                            label="Invite"
                                            variant="primary"
                                        >
                                            <Validate
                                                value="$invitation"
                                                rules="${{ email: { type: 'string', trim: true, minLength: 3 }, role: { type: 'string', trim: true, minLength: 1 } }}"
                                            />
                                            <Request
                                                url="/api/v1/organizations/${membership.organization.id}/invitations"
                                                method="POST"
                                                json="$invitation"
                                            />
                                            <Patch
                                                state="details"
                                                invalidate="true"
                                            />
                                            <Patch
                                                state="invitationDialog"
                                                value="${{ open: false }}"
                                            />
                                        </Button>
                                    </Stack>
                                </Dialog>
                            </Stack>
                            <Divider />
                            <Table
                                data="$details.invitations"
                                idKey="id"
                                hasHover="true"
                            >
                                <TableColumn field="email" header="Email" />
                                <TableColumn field="role" header="Role">
                                    <Badge>$row.role</Badge>
                                </TableColumn>
                                <TableColumn
                                    if="${membership.role === 'maintain' || membership.role === 'admin' || membership.role === 'owner'}"
                                    field="id"
                                    header="Actions"
                                    align="end"
                                >
                                    <Button
                                        label="Revoke"
                                        variant="destructive"
                                    >
                                        <Request
                                            url="/api/v1/organizations/${membership.organization.id}/invitations/${row.id}"
                                            method="DELETE"
                                        />
                                        <Patch
                                            state="details"
                                            invalidate="true"
                                        />
                                    </Button>
                                </TableColumn>
                            </Table>
                        </Stack>
                    </MenuItem>
                </MenuSubSection>
                <MenuItem label="Solutions" icon="boxes">
                    <Stack gap="4">
                        <Stack
                            direction="horizontal"
                            justify="between"
                            align="center"
                            wrap="wrap"
                        >
                            <Heading level="1">Solutions</Heading>
                            <Button
                                label="New Solution"
                                if="${membership.role === 'maintain' || membership.role === 'admin' || membership.role === 'owner'}"
                            >
                                <Patch
                                    state="createSolution"
                                    value="${{ description: '', envs: {}, image: '', inspecting: false, name: '', open: true, step: 0 }}"
                                />
                            </Button>
                        </Stack>
                        <Divider />
                        <Table data="$solutions" idKey="id" hasHover="true">
                            <TableColumn field="name" header="Solution">
                                <Stack>
                                    <Link
                                        to="/orgs/${params.organization}/solutions/${row.slug}"
                                    >
                                        $row.name
                                    </Link>
                                    <Text
                                        if="$row.description"
                                        type="supporting"
                                    >
                                        $row.description
                                    </Text>
                                </Stack>
                            </TableColumn>
                            <TableColumn
                                if="${membership.role === 'maintain' || membership.role === 'admin' || membership.role === 'owner'}"
                                field="id"
                                header="Actions"
                                align="end"
                            >
                                <MoreMenu value="$solutionMenu">
                                    <Option
                                        if="${row.desired_revision_id && !row.deployment_pending && row.status !== 'creating'}"
                                        value="${{ envs: {}, item: row, logsOpen: false, deleteOpen: false, open: false, removed: {}, reviewing: true }}"
                                        label="Update"
                                        icon="refresh"
                                    />
                                    <Option
                                        value="${{ item: row, logsOpen: true, deleteOpen: false, open: false, reviewing: false }}"
                                        label="Logs"
                                        icon="logs"
                                    />
                                    <Option
                                        value="${{ item: row, logsOpen: false, deleteOpen: true, open: false, reviewing: false }}"
                                        label="Delete"
                                        icon="trash"
                                    />
                                </MoreMenu>
                            </TableColumn>
                        </Table>
                    </Stack>
                </MenuItem>
            </MenuSection>
        </Menu>
    </Stack>

    <Dialog title="Change role" isOpen="$memberMenu.open" purpose="form">
        <Stack gap="3">
            <Text color="secondary">
                Change ${memberMenu.item.user.name} to ${memberMenu.role}?
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Button label="Cancel" variant="ghost">
                    <Patch state="memberMenu" value="${{ open: false }}" />
                </Button>
                <Button label="Confirm" variant="primary">
                    <Request
                        url="/api/v1/organizations/${membership.organization.id}/members/${memberMenu.item.user.id}"
                        method="PATCH"
                        json="${{ role: memberMenu.role }}"
                    />
                    <Patch state="details" invalidate="true" />
                    <Patch state="memberMenu" value="${{ open: false }}" />
                </Button>
            </Stack>
        </Stack>
    </Dialog>
    <Dialog
        title="Create solution"
        isOpen="$createSolution.open"
        purpose="form"
        height="calc(100dvh - 2rem)"
    >
        <Stepper
            activeStep="$createSolution.step"
            indicatorPosition="on-track"
            label="Solution creation"
            orientation="vertical"
        >
            <Step
                step="0"
                label="Image"
                description="Inspect the solution image."
            >
                <Stack if="${createSolution.step === 0}" gap="3">
                    <TextInput
                        label="Image"
                        value="$createSolution.image"
                        placeholder="ghcr.io/longlink/dashboard:latest"
                        isRequired="true"
                    />
                    <Stack
                        direction="horizontal"
                        gap="2"
                        justify="between"
                        wrap="wrap"
                    >
                        <Button label="Use sample Image" variant="ghost">
                            <Patch
                                state="createSolution"
                                value="${{ image: 'ghcr.io/xlonglink/sample:latest' }}"
                            />
                        </Button>
                        <Stack direction="horizontal" gap="2">
                            <Button label="Cancel" variant="ghost">
                                <Patch
                                    state="createSolution"
                                    value="${{ open: false }}"
                                />
                            </Button>
                            <Button label="Inspect image" variant="primary">
                                <Validate
                                    value="$createSolution"
                                    rules="${{ image: { type: 'string', trim: true, minLength: 1 } }}"
                                />
                                <Patch
                                    state="createSolution"
                                    value="${{ inspecting: true }}"
                                />
                                <Patch
                                    state="createSolutionMetadata"
                                    invalidate="true"
                                />
                                <Patch
                                    state="createSolution"
                                    value="${{ description: createSolutionMetadata.description || '', envs: {}, inspecting: false, step: 1 }}"
                                />
                            </Button>
                        </Stack>
                    </Stack>
                </Stack>
            </Step>
            <Step
                step="1"
                label="Metadata"
                description="Name and describe the solution."
            >
                <Stack if="${createSolution.step === 1}" gap="3">
                    <TextInput
                        label="Name"
                        value="$createSolution.name"
                        isRequired="true"
                    />
                    <TextInput
                        label="Description"
                        value="$createSolution.description"
                        placeholder="Dashboard solution"
                    />
                    <Stack
                        direction="horizontal"
                        gap="2"
                        justify="between"
                        wrap="wrap"
                    >
                        <Button label="Back" variant="ghost">
                            <Patch
                                state="createSolution"
                                value="${{ step: 0 }}"
                            />
                        </Button>
                        <Stack direction="horizontal" gap="2">
                            <Button label="Cancel" variant="ghost">
                                <Patch
                                    state="createSolution"
                                    value="${{ open: false }}"
                                />
                            </Button>
                            <Button label="Next" variant="primary">
                                <Validate
                                    value="$createSolution"
                                    rules="${{ name: { type: 'string', trim: true, minLength: 1 } }}"
                                />
                                <Patch
                                    state="createSolution"
                                    value="${{ step: 2 }}"
                                />
                            </Button>
                        </Stack>
                    </Stack>
                </Stack>
            </Step>
            <Step
                step="2"
                label="Environment"
                description="Configure environment values."
            >
                <Stack if="${createSolution.step === 2}" gap="3">
                    <For
                        each="$createSolutionMetadata.environments"
                        as="environment"
                    >
                        <TextInput
                            label="$environment.name"
                            value="$createSolution.envs"
                            property="$environment.name"
                            placeholder="$environment.description"
                            isRequired="$environment.required"
                        />
                    </For>
                    <Stack
                        direction="horizontal"
                        gap="2"
                        justify="between"
                        wrap="wrap"
                    >
                        <Button label="Back" variant="ghost">
                            <Patch
                                state="createSolution"
                                value="${{ step: 1 }}"
                            />
                        </Button>
                        <Stack direction="horizontal" gap="2">
                            <Button label="Cancel" variant="ghost">
                                <Patch
                                    state="createSolution"
                                    value="${{ open: false }}"
                                />
                            </Button>
                            <Button
                                label="Create"
                                variant="primary"
                            >
                                <Request
                                    url="/api/v1/organizations/${membership.organization.id}/solutions"
                                    method="POST"
                                    json="${{ description: createSolution.description || null, envs: nonEmpty(createSolution.envs), image: createSolution.image, name: createSolution.name }}"
                                />
                                <Patch state="solutions" invalidate="true" />
                                <Patch
                                    state="createSolution"
                                    value="${{ open: false }}"
                                />
                            </Button>
                        </Stack>
                    </Stack>
                </Stack>
            </Step>
        </Stepper>
    </Dialog>
    <Dialog
        title="Update ${solutionMenu.item.name}"
        isOpen="$solutionMenu.open"
        purpose="form"
        height="calc(100dvh - 2rem)"
    >
        <Stack gap="3">
            <Stack direction="horizontal" gap="2" align="center" wrap="wrap">
                <Text type="supporting" color="secondary">
                    Current ${updateCandidate.current_image_digest}
                </Text>
                <Text type="supporting" color="primary">
                    New ${updateCandidate.image_digest}
                </Text>
            </Stack>
            <For each="$updateCandidate.metadata.environments" as="environment">
                <Stack gap="2">
                    <TextInput
                        label="$environment.name"
                        labelTooltip="$environment.description"
                        type="password"
                        value="$solutionMenu.envs"
                        property="$environment.name"
                        isDisabled="${solutionMenu.removed[environment.name] === true}"
                        isOptional="${!environment.required}"
                        isRequired="${environment.required && (!hasConfiguredEnvironment(updateCandidate.configured_envs, environment.name) || solutionMenu.removed[environment.name] === true)}"
                        placeholder="${solutionMenu.removed[environment.name] === true ? 'Will be removed' : hasConfiguredEnvironment(updateCandidate.configured_envs, environment.name) ? 'Configured: preserve existing value' : environment.description || 'Enter value'}"
                    />
                    <CheckboxInput
                        if="${hasConfiguredEnvironment(updateCandidate.configured_envs, environment.name) && !environment.required}"
                        label="Remove ${environment.name}"
                        value="$solutionMenu.removed"
                        property="$environment.name"
                    />
                </Stack>
            </For>
            <Stack direction="horizontal" gap="2" justify="end" wrap="wrap">
                <Button label="Cancel" variant="ghost">
                    <Patch state="solutionMenu" value="${{ open: false }}" />
                </Button>
                <Button
                    label="Update solution"
                    variant="primary"
                    disabled="${hasMissingRequiredUpdateValues(updateCandidate.metadata.environments, updateCandidate.configured_envs, solutionMenu.envs, solutionMenu.removed) || !hasSolutionUpdateChanges(updateCandidate, solutionMenu.envs, solutionMenu.removed)}"
                >
                    <Request
                        url="/api/v1/solutions/${solutionMenu.item.id}/update"
                        method="POST"
                        json="${{ envs: updateEnvironmentPatch(solutionMenu.envs, solutionMenu.removed), expected_revision_id: updateCandidate.revision_id }}"
                    />
                    <Patch state="solutions" invalidate="true" />
                    <Patch state="solutionMenu" value="${{ open: false }}" />
                </Button>
            </Stack>
        </Stack>
    </Dialog>
    <Dialog title="Pod logs" isOpen="$solutionMenu.logsOpen" width="1280">
        <Invalidate query="solutionLogs" if="$solutionMenu.logsOpen" />
        <Stack height="60vh">
            <StackItem size="static">
                <CodeBlock value="$solutionLogs" hasLineNumbers="true" />
            </StackItem>
        </Stack>
    </Dialog>
    <Dialog
        title="Delete solution"
        isOpen="$solutionMenu.deleteOpen"
        purpose="form"
    >
        <Stack gap="3">
            <Text color="secondary">
                Delete solution ${solutionMenu.item.name}?
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Button label="Cancel" variant="ghost">
                    <Patch
                        state="solutionMenu"
                        value="${{ deleteOpen: false }}"
                    />
                </Button>
                <Button label="Delete" variant="destructive">
                    <Request
                        url="/api/v1/solutions/${solutionMenu.item.id}"
                        method="DELETE"
                    />
                    <Patch state="solutions" invalidate="true" />
                    <Patch
                        state="solutionMenu"
                        value="${{ deleteOpen: false }}"
                    />
                </Button>
            </Stack>
        </Stack>
    </Dialog>
</view>
