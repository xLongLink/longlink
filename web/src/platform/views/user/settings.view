<view name="Account Settings" icon="settings2">
    <State id="profile" name="$params.userName" />
    <Query id="memberships" path="/api/v1/me/organizations" />
    <State id="deletion" item="${null}" open="${false}" />
    <State id="organizationDraft" name="" />
    <State id="createDialog" open="${false}" />

    <Stack gap="8">
        <Stack direction="horizontal" gap="3" align="start">
            <Avatar name="$profile.name" src="$params.userAvatar" />
            <Stack gap="1">
                <Heading level="4" accessibilityLevel="1">
                    $profile.name
                </Heading>
                <Text type="supporting">Your Account</Text>
            </Stack>
        </Stack>

        <Menu>
            <MenuSection title="Settings" isHeaderHidden="true">
                <MenuItem label="Account" icon="userRound">
                    <Stack gap="4">
                        <Heading level="2">Account</Heading>
                        <Divider />
                        <TextInput
                            label="Username"
                            value="$profile.name"
                            isRequired="true"
                        />
                        <Text>
                            <b>Email</b>
                            $params.userEmail
                        </Text>
                        <Stack direction="horizontal" justify="end">
                            <Button
                                label="Save account"
                                variant="primary"
                                disabled="${!trim(profile.name)}"
                            >
                                <Validate
                                    value="$profile"
                                    rules="${{ name: { type: 'string', trim: true, minLength: 1 } }}"
                                />
                                <Request
                                    url="/api/v1/me"
                                    method="PATCH"
                                    json="${{ name: profile.name }}"
                                />
                            </Button>
                        </Stack>
                    </Stack>
                </MenuItem>
                <MenuItem label="Organizations" icon="building2">
                    <Stack gap="4">
                        <Stack
                            direction="horizontal"
                            justify="between"
                            align="center"
                            wrap="wrap"
                        >
                            <Heading level="2">Organizations</Heading>
                            <Dialog
                                title="New organization"
                                triggerLabel="Create Organization"
                                isOpen="$createDialog.open"
                                purpose="form"
                            >
                                <Stack gap="3">
                                    <TextInput
                                        label="Name"
                                        value="$organizationDraft.name"
                                        placeholder="Example LongLink"
                                        isRequired="true"
                                    />
                                    <Button
                                        label="Create organization"
                                        variant="primary"
                                        disabled="${!trim(organizationDraft.name)}"
                                    >
                                        <Request
                                            url="/api/v1/organizations"
                                            method="POST"
                                            json="${{ name: trim(organizationDraft.name) }}"
                                        />
                                        <Patch
                                            state="memberships"
                                            invalidate="true"
                                        />
                                        <Patch
                                            state="createDialog"
                                            value="${{ open: false }}"
                                        />
                                    </Button>
                                </Stack>
                            </Dialog>
                        </Stack>
                        <Divider />
                        <Table
                            data="$memberships"
                            idKey="organization.id"
                            hasHover="true"
                        >
                            <TableColumn
                                field="organization.name"
                                header="Name"
                            >
                                <Stack
                                    direction="horizontal"
                                    gap="3"
                                    align="center"
                                >
                                    <Avatar
                                        shape="rounded"
                                        name="$row.organization.name"
                                    />
                                    <Stack align="start">
                                        <Stack
                                            direction="horizontal"
                                            gap="1"
                                            align="center"
                                        >
                                            <Link
                                                to="/orgs/${row.organization.slug}"
                                            >
                                                $row.organization.name
                                            </Link>
                                            <Badge>$row.role</Badge>
                                        </Stack>
                                        <Text type="supporting">
                                            Organization
                                        </Text>
                                    </Stack>
                                </Stack>
                            </TableColumn>
                            <TableColumn
                                field="organization.id"
                                header="Actions"
                                align="end"
                            >
                                <Button
                                    label="Delete"
                                    if="${row.role === 'owner'}"
                                    variant="destructive"
                                >
                                    <Patch
                                        state="deletion"
                                        value="${{ item: row, open: true }}"
                                    />
                                </Button>
                            </TableColumn>
                        </Table>
                    </Stack>
                </MenuItem>
            </MenuSection>
        </Menu>
    </Stack>

    <Dialog title="Delete organization" isOpen="$deletion.open" purpose="form">
        <Stack gap="3">
            <Text color="secondary">
                Delete $deletion.item.organization.name from your account?
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Button label="Cancel" variant="ghost">
                    <Patch
                        state="deletion"
                        value="${{ item: null, open: false }}"
                    />
                </Button>
                <Button label="Delete" variant="destructive">
                    <Request
                        url="/api/v1/organizations/${deletion.item.organization.id}"
                        method="DELETE"
                    />
                    <Patch state="memberships" invalidate="true" />
                    <Patch state="deletion" value="${{ open: false }}" />
                </Button>
            </Stack>
        </Stack>
    </Dialog>
</view>
