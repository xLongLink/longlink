<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink name="Organizations" icon="building2">
    <Query id="memberships" path="/api/v1/me/organizations" />
    <State id="draft" name="" />
    <State id="createDialog" open="${false}" />

    <Stack gap="8">
        <Stack
            direction="horizontal"
            justify="between"
            align="center"
            wrap="wrap"
        >
            <Heading level="1">Organizations</Heading>
            <Dialog
                title="New organization"
                triggerLabel="Create Organization"
                isOpen="$createDialog.open"
                purpose="form"
            >
                <Stack gap="3">
                    <TextInput
                        label="Name"
                        value="$draft.name"
                        placeholder="Example LongLink"
                        isRequired="true"
                    />
                    <Button
                        label="Create organization"
                        variant="primary"
                        disabled="${!trim(draft.name)}"
                    >
                        <Request
                            url="/api/v1/organizations"
                            method="POST"
                            json="${{ name: trim(draft.name) }}"
                        />
                        <Patch state="memberships" invalidate="true" />
                        <Patch
                            state="createDialog"
                            value="${{ open: false }}"
                        />
                    </Button>
                </Stack>
            </Dialog>
        </Stack>

        <Table data="$memberships" idKey="organization.id" hasHover="true">
            <TableColumn field="organization.name" header="Name">
                <Stack direction="horizontal" gap="3" align="center">
                    <Avatar shape="rounded" name="$row.organization.name" />
                    <Stack align="start" gap="0">
                        <Link to="/orgs/${row.organization.slug}">
                            $row.organization.name
                        </Link>
                        <Text type="supporting">Organization</Text>
                    </Stack>
                </Stack>
            </TableColumn>
        </Table>
    </Stack>
</longlink>
