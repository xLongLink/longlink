<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink name="Organizations" icon="building2">
    <State id="pages" value="${1}" />
    <State id="metadata" item="${null}" open="${false}" />
    <State id="deletion" item="${null}" open="${false}" />
    <Query
        id="organizations"
        path="/api/v1/organizations?page=${pages.value}&amp;page_size=25"
    />

    <Stack gap="8">
        <Stack>
            <Heading level="1">Organizations</Heading>
            <Text color="secondary">
                Review organization lifecycle, ownership, and access boundaries.
            </Text>
        </Stack>
        <Table data="$organizations.items" idKey="id" hasHover="true">
            <TableColumn field="name" header="Name">
                <Stack direction="horizontal" gap="3" align="center">
                    <Avatar
                        kind="organization"
                        name="$row.name"
                        src="$row.avatar"
                    />
                    <Stack align="start">
                        <Stack direction="horizontal" gap="1" align="center">
                            <Link to="/orgs/${row.slug}">$row.name</Link>
                            <StatusBadge status="$row.status" />
                        </Stack>
                        <Text type="supporting">Organization</Text>
                    </Stack>
                </Stack>
            </TableColumn>
            <TableColumn field="id" header="Actions">
                <MoreMenu value="$metadata">
                    <Option
                        value="${{ item: row, open: true }}"
                        label="Metadata"
                        icon="info"
                    />
                </MoreMenu>
            </TableColumn>
        </Table>
        <Stack direction="horizontal" gap="2" justify="end">
            <Action>
                <Patch state="pages" value="${{ value: pages.value - 1 }}" />
                <Patch state="organizations" invalidate="true" />
                <Button disabled="${pages.value === 1}">Previous</Button>
            </Action>
            <Action>
                <Patch state="pages" value="${{ value: pages.value + 1 }}" />
                <Patch state="organizations" invalidate="true" />
                <Button
                    disabled="${organizations.total &lt;= pages.value * 25}"
                >
                    Next
                </Button>
            </Action>
        </Stack>
    </Stack>

    <Dialog title="Organization metadata" isOpen="$metadata.open">
        <Stack gap="2">
            <Text>
                <b>Status</b>
                $metadata.item.status
            </Text>
            <Text>
                <b>Slug</b>
                $metadata.item.slug
            </Text>
            <Text>
                <b>ID</b>
                $metadata.item.id
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Action>
                    <Patch
                        state="metadata"
                        value="${{ item: metadata.item, open: false }}"
                    />
                    <Patch
                        state="deletion"
                        value="${{ item: metadata.item, open: true }}"
                    />
                    <Button variant="destructive">Delete</Button>
                </Action>
            </Stack>
        </Stack>
    </Dialog>
    <Dialog title="Delete organization" isOpen="$deletion.open" purpose="form">
        <Stack gap="3">
            <Text color="secondary">
                Delete organization $deletion.item.name?
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Action>
                    <Patch
                        state="deletion"
                        value="${{ item: deletion.item, open: false }}"
                    />
                    <Button variant="ghost">Cancel</Button>
                </Action>
                <Action>
                    <Request
                        url="/api/v1/organizations/${deletion.item.id}"
                        method="DELETE"
                        closeDialog="true"
                    />
                    <Patch state="organizations" invalidate="true" />
                    <Button variant="destructive">Delete</Button>
                </Action>
            </Stack>
        </Stack>
    </Dialog>
</longlink>
