<longlink name="Organizations" icon="building2">
    <State id="pages" value="${1}" />
    <State id="metadata" item="${null}" open="${false}" />
    <State id="deletion" item="${null}" open="${false}" />
    <Query
        id="organizations"
        path="/api/v1/organizations?page=${pages.value}&page_size=25"
    />

    <Stack gap="8">
        <Heading level="1">Organizations</Heading>
        <Stack gap="1">
            <Table data="$organizations.items" idKey="id" hasHover="true">
                <TableColumn field="name" header="Name">
                    <Stack direction="horizontal" gap="3" align="center">
                        <Avatar shape="rounded" name="$row.name" />
                        <Stack align="start">
                            <Stack
                                direction="horizontal"
                                gap="1"
                                align="center"
                            >
                                <Link to="/orgs/${row.slug}">$row.name</Link>
                                <StatusBadge status="$row.status" />
                            </Stack>
                            <Text type="supporting">Organization</Text>
                        </Stack>
                    </Stack>
                </TableColumn>
                <TableColumn field="id" header="Actions" align="end">
                    <MoreMenu value="$metadata">
                        <Option
                            value="${{ item: row, open: true }}"
                            label="Metadata"
                            icon="info"
                        />
                    </MoreMenu>
                </TableColumn>
            </Table>
            <Stack direction="horizontal" gap="2" justify="between">
                <Button label="Previous" disabled="${pages.value === 1}">
                    <Patch
                        state="pages"
                        value="${{ value: pages.value - 1 }}"
                    />
                    <Patch state="organizations" invalidate="true" />
                </Button>
                <Button
                    label="Next"
                    disabled="${organizations.total <= pages.value * 25}"
                >
                    <Patch
                        state="pages"
                        value="${{ value: pages.value + 1 }}"
                    />
                    <Patch state="organizations" invalidate="true" />
                </Button>
            </Stack>
        </Stack>
    </Stack>

    <Dialog title="Organization metadata" isOpen="$metadata.open">
        <Stack gap="2">
            <Text>
                <b>Status</b>
                $metadata.item.status
            </Text>
            <Text>
                <b>Slug</b>
                $metadata.item.slug
            </Text>
            <Text>
                <b>ID</b>
                $metadata.item.id
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Button label="Delete" variant="destructive">
                    <Patch
                        state="metadata"
                        value="${{ item: metadata.item, open: false }}"
                    />
                    <Patch
                        state="deletion"
                        value="${{ item: metadata.item, open: true }}"
                    />
                </Button>
            </Stack>
        </Stack>
    </Dialog>
    <Dialog title="Delete organization" isOpen="$deletion.open" purpose="form">
        <Stack gap="3">
            <Text color="secondary">
                Delete organization ${deletion.item.name}?
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Button label="Cancel" variant="ghost">
                    <Patch
                        state="deletion"
                        value="${{ item: deletion.item, open: false }}"
                    />
                </Button>
                <Button label="Delete" variant="destructive">
                    <Request
                        url="/api/v1/organizations/${deletion.item.id}"
                        method="DELETE"
                    />
                    <Patch state="organizations" invalidate="true" />
                    <Patch state="deletion" value="${{ open: false }}" />
                </Button>
            </Stack>
        </Stack>
    </Dialog>
</longlink>
