<view name="Solutions" icon="appWindow">
    <State id="pages" value="${1}" />
    <State id="metadata" item="${null}" open="${false}" />
    <State id="deletion" item="${null}" open="${false}" />
    <Query
        id="solutions"
        path="/api/v1/solutions?page=${pages.value}&page_size=25"
    />

    <Stack gap="8">
        <Heading level="1">Solutions</Heading>
        <Stack gap="1">
            <Table data="$solutions.items" idKey="id" hasHover="true">
                <TableColumn field="name" header="Solution" width="${1}">
                    <Stack align="start">
                        <Stack direction="horizontal" gap="1" align="center">
                            <Link
                                to="/orgs/${row.organization.slug}/solutions/${row.slug}"
                            >
                                $row.name
                            </Link>
                            <StatusBadge status="$row.status" />
                        </Stack>
                        <Text if="$row.description" type="supporting">
                            $row.description
                        </Text>
                    </Stack>
                </TableColumn>
                <TableColumn
                    field="organization.name"
                    header="Organization"
                    width="${1}"
                >
                    <Stack direction="horizontal" gap="3" align="center">
                        <Avatar shape="rounded" name="$row.organization.name" />
                        <Stack align="start">
                            <Link to="/orgs/${row.organization.slug}">
                                $row.organization.name
                            </Link>
                            <Text type="supporting">Organization</Text>
                        </Stack>
                    </Stack>
                </TableColumn>
                <TableColumn field="image_desired" header="Image" width="${2}">
                    <Stack align="start">
                        <Text>
                            $row.image_reference
                        </Text>
                        <Text type="supporting">
                            Revision: ${row.desired_revision_id ?? 'Not selected'}
                        </Text>
                    </Stack>
                </TableColumn>
                <TableColumn
                    field="id"
                    header="Actions"
                    align="end"
                    width="${0.5}"
                >
                    <MoreMenu value="$metadata">
                        <Option
                            value="${{ item: row, open: true }}"
                            label="Metadata"
                            icon="info"
                        />
                    </MoreMenu>
                </TableColumn>
            </Table>
            <Stack direction="horizontal" gap="2" justify="between">
                <Button label="Previous" disabled="${pages.value === 1}">
                    <Patch
                        state="pages"
                        value="${{ value: pages.value - 1 }}"
                    />
                    <Patch state="solutions" invalidate="true" />
                </Button>
                <Button
                    label="Next"
                    disabled="${solutions.total <= pages.value * 25}"
                >
                    <Patch
                        state="pages"
                        value="${{ value: pages.value + 1 }}"
                    />
                    <Patch state="solutions" invalidate="true" />
                </Button>
            </Stack>
        </Stack>
    </Stack>

    <Dialog title="Solution metadata" isOpen="$metadata.open">
        <Stack gap="2">
            <Text>
                <b>Status</b>
                $metadata.item.status
            </Text>
            <Text>
                <b>Organization</b>
                $metadata.item.organization.name
            </Text>
            <Text>
                <b>Desired image</b>
                $metadata.item.image_desired
            </Text>
            <Text>
                <b>Desired revision</b>
                ${metadata.item.desired_revision_id ?? 'Not selected'}
            </Text>
            <Text>
                <b>Last deployed revision</b>
                ${metadata.item.deployed_revision_id ?? 'Never deployed'}
            </Text>
            <Text>
                <b>ID</b>
                $metadata.item.id
            </Text>
            <Text>
                <b>Slug</b>
                $metadata.item.slug
            </Text>
            <Text if="$metadata.item.description">
                <b>Description</b>
                $metadata.item.description
            </Text>
            <Text>
                <b>Created</b>
                $metadata.item.created_at
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Button label="Delete" variant="destructive">
                    <Patch
                        state="metadata"
                        value="${{ item: metadata.item, open: false }}"
                    />
                    <Patch
                        state="deletion"
                        value="${{ item: metadata.item, open: true }}"
                    />
                </Button>
            </Stack>
        </Stack>
    </Dialog>
    <Dialog title="Delete solution" isOpen="$deletion.open" purpose="form">
        <Stack gap="3">
            <Text color="secondary">
                Delete solution ${deletion.item.name}?
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Button label="Cancel" variant="ghost">
                    <Patch
                        state="deletion"
                        value="${{ item: deletion.item, open: false }}"
                    />
                </Button>
                <Button label="Delete" variant="destructive">
                    <Request
                        url="/api/v1/solutions/${deletion.item.id}"
                        method="DELETE"
                    />
                    <Patch state="solutions" invalidate="true" />
                    <Patch state="deletion" value="${{ open: false }}" />
                </Button>
            </Stack>
        </Stack>
    </Dialog>
</view>
