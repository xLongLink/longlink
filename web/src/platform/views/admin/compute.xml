<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink name="Compute" icon="wrench">
    <State id="pages" value="${1}" />
    <State id="metadata" item="${null}" open="${false}" />
    <State id="deletion" item="${null}" open="${false}" />
    <State id="registrationDialog" open="${false}" />
    <State
        id="registration"
        name=""
        kubeconfig=""
        gateway_url=""
        database_storage_class=""
        storage_endpoint=""
    />
    <Query
        id="computes"
        path="/api/v1/computes?page=${pages.value}&amp;page_size=25"
    />

    <Stack gap="8">
        <Stack
            direction="horizontal"
            justify="between"
            align="center"
            wrap="wrap"
        >
            <Stack>
                <Heading level="1">Compute</Heading>
                <Text color="secondary">
                    Manage Kubernetes connections and Kourier gateways.
                </Text>
            </Stack>
            <Action>
                <Patch
                    state="registration"
                    value="${{ name: '', kubeconfig: '', gateway_url: '', database_storage_class: '', storage_endpoint: '' }}"
                />
                <Patch state="registrationDialog" value="${{ open: true }}" />
                <Button>Register Compute</Button>
            </Action>
        </Stack>
        <Table data="$computes.items" idKey="id" hasHover="true">
            <TableColumn field="name" header="Compute">
                <Stack align="start">
                    <Text>$row.name</Text>
                    <Text type="supporting">$row.gateway_url</Text>
                </Stack>
            </TableColumn>
            <TableColumn field="live_version" header="Version" />
            <TableColumn field="id" header="Actions" align="end">
                <MoreMenu value="$metadata">
                    <Option
                        value="${{ item: row, open: true }}"
                        label="Metadata"
                        icon="info"
                    />
                </MoreMenu>
            </TableColumn>
        </Table>
        <Stack direction="horizontal" gap="2" justify="end">
            <Action>
                <Patch state="pages" value="${{ value: pages.value - 1 }}" />
                <Patch state="computes" invalidate="true" />
                <Button disabled="${pages.value === 1}">Previous</Button>
            </Action>
            <Action>
                <Patch state="pages" value="${{ value: pages.value + 1 }}" />
                <Patch state="computes" invalidate="true" />
                <Button disabled="${computes.total &lt;= pages.value * 25}">
                    Next
                </Button>
            </Action>
        </Stack>
    </Stack>

    <Dialog
        title="Register Compute"
        isOpen="$registrationDialog.open"
        purpose="form"
    >
        <Stack gap="3">
            <Stack gap="3" height="50dvh">
                <TextInput
                    label="Name"
                    value="$registration.name"
                    isRequired="true"
                />
                <TextInput
                    label="Gateway URL"
                    value="$registration.gateway_url"
                    isRequired="true"
                />
                <TextInput
                    label="Database storage class"
                    value="$registration.database_storage_class"
                    isRequired="true"
                />
                <TextInput
                    label="Storage controller HTTPS endpoint"
                    value="$registration.storage_endpoint"
                    placeholder="https://storage.example:9443"
                    isRequired="true"
                />
                <Text type="supporting">
                    Reachable from the Platform. Administrator keys are read
                    from rustfs/longlink-rustfs; TLS certificates are read
                    through the Kubeconfig. Workloads use
                    https://longlink-storage.rustfs.svc:443.
                </Text>
                <TextArea label="Kubeconfig" value="$registration.kubeconfig" isRequired="true" />
            </Stack>
            <Stack direction="horizontal" gap="2" justify="end">
                <Action>
                    <Patch
                        state="registrationDialog"
                        value="${{ open: false }}"
                    />
                    <Button variant="ghost">Cancel</Button>
                </Action>
                <Action>
                    <Validate
                        value="$registration"
                        rules="${{ name: { type: 'string', trim: true, minLength: 1, maxLength: 128 }, kubeconfig: { type: 'string', trim: true, minLength: 1 }, gateway_url: { type: 'string', trim: true, maxLength: 512, format: 'https-origin' }, database_storage_class: { type: 'string', minLength: 1, maxLength: 253, pattern: '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$' }, storage_endpoint: { type: 'string', trim: true, maxLength: 512, format: 'https-url' } }}"
                    />
                    <Request
                        url="/api/v1/computes"
                        method="POST"
                        json="$registration"
                        closeDialog="true"
                    />
                    <Patch state="computes" invalidate="true" />
                    <Button variant="primary">Register</Button>
                </Action>
            </Stack>
        </Stack>
    </Dialog>
    <Dialog title="Compute metadata" isOpen="$metadata.open">
        <Stack gap="2">
            <Text>
                <b>Gateway</b>
                $metadata.item.gateway_url
            </Text>
            <Text>
                <b>Live version</b>
                $metadata.item.live_version
            </Text>
            <Text>
                <b>Database storage class</b>
                $metadata.item.database_storage_class
            </Text>
            <Text>
                <b>ID</b>
                $metadata.item.id
            </Text>
            <Text>
                <b>Storage endpoint</b>
                $metadata.item.storage_endpoint
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Action>
                    <Patch
                        state="metadata"
                        value="${{ item: metadata.item, open: false }}"
                    />
                    <Patch
                        state="deletion"
                        value="${{ item: metadata.item, open: true }}"
                    />
                    <Button variant="destructive">Delete</Button>
                </Action>
            </Stack>
        </Stack>
    </Dialog>
    <Dialog title="Delete compute" isOpen="$deletion.open" purpose="form">
        <Stack gap="3">
            <Text color="secondary">
                Remove compute ${deletion.item.name} from the LongLink
                Platform? Its Kubernetes resources will remain unchanged.
            </Text>
            <Stack direction="horizontal" gap="2" justify="end">
                <Action>
                    <Patch
                        state="deletion"
                        value="${{ item: deletion.item, open: false }}"
                    />
                    <Button variant="ghost">Cancel</Button>
                </Action>
                <Action>
                    <Request
                        url="/api/v1/computes/${deletion.item.id}"
                        method="DELETE"
                        closeDialog="true"
                    />
                    <Patch state="computes" invalidate="true" />
                    <Button variant="destructive">Delete</Button>
                </Action>
            </Stack>
        </Stack>
    </Dialog>
</longlink>
