<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink name="Compute" icon="wrench">
    <State id="pages" value="${1}" />
    <State id="metadata" item="${null}" open="${false}" />
    <State id="deletion" item="${null}" open="${false}" />
    <State id="registrationDialog" open="${false}" />
    <State id="registration" name="" kubeconfig="" gateway_url="" gateway_certificate="" database_storage_class="" database_size_gib="${10}" database_instances="${1}" storage_class="" storage_endpoint="https://rook-ceph-rgw-longlink.rook-ceph.svc:443" storage_size_gib="${100}" storage_instances="${3}" storage_certificate="" bucket_size_bytes="${1024}" bucket_max_objects="${1}" storage_reserve_percent="${1}" storage_object_overhead_bytes="${4096}" />
    <Query id="computes" path="/api/v1/computes" page="$pages.value" pageSize="25" pollInterval="5000" />

    <Stack gap="8">
        <Stack direction="horizontal" justify="between" align="center" wrap="wrap"><Stack><Heading level="1">Compute</Heading><Text color="secondary">Manage Kubernetes connections, Kourier gateways, and database provisioning settings.</Text></Stack><Action><Patch state="registration" value="${{ name: '', kubeconfig: '', gateway_url: '', gateway_certificate: '', database_storage_class: '', database_size_gib: 10, database_instances: 1, storage_class: '', storage_endpoint: 'https://rook-ceph-rgw-longlink.rook-ceph.svc:443', storage_size_gib: 100, storage_instances: 3, storage_certificate: '', bucket_size_bytes: 1024, bucket_max_objects: 1, storage_reserve_percent: 1, storage_object_overhead_bytes: 4096 }}" /><Patch state="registrationDialog" value="${{ open: true }}" /><Button>Register Compute</Button></Action></Stack>
        <Table data="$computes.items" idKey="id" hasHover="true">
            <TableColumn field="name" header="Compute"><Stack align="start"><Stack direction="horizontal" gap="1" align="center"><Text>$row.name</Text><StatusBadge status="$row.status" /></Stack><Text type="supporting">$row.gateway_url</Text></Stack></TableColumn>
            <TableColumn field="id" header="Actions"><Action><Patch state="metadata" value="${{ item: row, open: true }}" /><Button variant="ghost">Metadata</Button></Action></TableColumn>
        </Table>
        <Stack direction="horizontal" gap="2" justify="end">
            <Action><Patch state="pages" value="${{ value: pages.value - 1 }}" /><Patch state="computes" invalidate="true" /><Button disabled="${pages.value === 1}">Previous</Button></Action>
            <Action><Patch state="pages" value="${{ value: pages.value + 1 }}" /><Patch state="computes" invalidate="true" /><Button disabled="${computes.total &lt;= pages.value * 25}">Next</Button></Action>
        </Stack>
    </Stack>

    <Dialog title="Register Compute" isOpen="$registrationDialog.open" purpose="form">
        <Stack gap="3">
            <TextInput label="Name" value="$registration.name" isRequired="true" /><TextInput label="Gateway URL" value="$registration.gateway_url" isRequired="true" /><TextArea label="Gateway CA certificate" value="$registration.gateway_certificate" /><TextInput label="Database storage class" value="$registration.database_storage_class" isRequired="true" /><NumberInput label="Database size per instance" value="$registration.database_size_gib" min="1" max="65536" step="1" /><NumberInput label="Database instances" value="$registration.database_instances" min="1" max="3" step="1" /><TextInput label="Ceph backing storage class" value="$registration.storage_class" isRequired="true" /><TextInput label="Storage HTTPS endpoint" value="$registration.storage_endpoint" isRequired="true" /><NumberInput label="Ceph capacity per OSD" value="$registration.storage_size_gib" min="10" max="65536" step="1" /><NumberInput label="Ceph replicas" value="$registration.storage_instances" min="1" max="3" step="2" /><TextArea label="Storage CA certificate" value="$registration.storage_certificate" /><NumberInput label="Organization bucket byte quota" value="$registration.bucket_size_bytes" min="1024" max="70368744177664" step="1024" /><NumberInput label="Organization bucket object quota" value="$registration.bucket_max_objects" min="1" max="2147483647" step="1" /><NumberInput label="Ceph capacity headroom" value="$registration.storage_reserve_percent" min="1" max="99" step="1" /><NumberInput label="Reserved overhead per object" value="$registration.storage_object_overhead_bytes" min="4096" max="1073741824" step="1" /><TextArea label="Kubeconfig" value="$registration.kubeconfig" />
            <Stack direction="horizontal" gap="2" justify="end"><Action><Patch state="registrationDialog" value="${{ open: false }}" /><Button variant="ghost">Cancel</Button></Action><Action><Validate value="$registration" rules="${{ name: { type: 'string', trim: true, minLength: 1, maxLength: 128 }, kubeconfig: { type: 'string', trim: true, minLength: 1 }, gateway_url: { type: 'string', trim: true, maxLength: 512, format: 'https-origin' }, gateway_certificate: { type: 'string', nullable: true, maxLength: 65536 }, database_storage_class: { type: 'string', minLength: 1, maxLength: 253, pattern: '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$' }, database_size_gib: { type: 'number', integer: true, min: 1, max: 65536 }, database_instances: { type: 'number', integer: true, min: 1, max: 3 }, storage_class: { type: 'string', minLength: 1, maxLength: 253 }, storage_endpoint: { type: 'string', trim: true, maxLength: 512, format: 'https-url' }, storage_size_gib: { type: 'number', integer: true, min: 10, max: 65536 }, storage_instances: { type: 'number', integer: true, oneOf: '1,3' }, storage_certificate: { type: 'string', nullable: true, maxLength: 65536 }, bucket_size_bytes: { type: 'number', integer: true, min: 1024, max: 70368744177664, multipleOf: 1024 }, bucket_max_objects: { type: 'number', integer: true, min: 1, max: 2147483647 }, storage_reserve_percent: { type: 'number', integer: true, min: 1, max: 99 }, storage_object_overhead_bytes: { type: 'number', integer: true, min: 4096, max: 1073741824 } }}" /><Request url="/api/v1/computes" method="POST" json="$registration" closeDialog="true" /><Patch state="computes" invalidate="true" /><Button variant="primary">Register</Button></Action></Stack>
        </Stack>
    </Dialog>
    <Dialog title="Compute metadata" isOpen="$metadata.open"><Stack gap="2"><Text><b>Status</b> $metadata.item.status</Text><Text><b>Gateway</b> $metadata.item.gateway_url</Text><Text><b>Database storage class</b> $metadata.item.database_storage_class</Text><Text><b>Database size per instance</b> $metadata.item.database_size_gib GiB</Text><Text><b>Database instances</b> $metadata.item.database_instances</Text><Text><b>ID</b> $metadata.item.id</Text><Text><b>Storage endpoint</b> $metadata.item.storage_endpoint</Text><Text><b>Ceph backing class</b> $metadata.item.storage_class</Text><Text><b>Ceph capacity per OSD</b> $metadata.item.storage_size_gib GiB</Text><Text><b>Ceph replicas</b> $metadata.item.storage_instances</Text><Text><b>Organization bucket byte quota</b> $metadata.item.bucket_size_bytes bytes</Text><Text><b>Organization bucket object quota</b> $metadata.item.bucket_max_objects</Text><Text><b>Ceph capacity headroom</b> $metadata.item.storage_reserve_percent%</Text><Text><b>Reserved overhead per object</b> $metadata.item.storage_object_overhead_bytes bytes</Text><Stack direction="horizontal" gap="2" justify="end"><Action><Patch state="metadata" value="${{ item: metadata.item, open: false }}" /><Patch state="deletion" value="${{ item: metadata.item, open: true }}" /><Button variant="destructive">Delete</Button></Action></Stack></Stack></Dialog>
    <Dialog title="Delete compute" isOpen="$deletion.open" purpose="form"><Stack gap="3"><Text color="secondary">Remove compute $deletion.item.name from the LongLink Platform? Its Kubernetes resources will remain unchanged.</Text><Stack direction="horizontal" gap="2" justify="end"><Action><Patch state="deletion" value="${{ item: deletion.item, open: false }}" /><Button variant="ghost">Cancel</Button></Action><Action><Request url="/api/v1/computes/${deletion.item.id}" method="DELETE" closeDialog="true" /><Patch state="computes" invalidate="true" /><Button variant="destructive">Delete</Button></Action></Stack></Stack></Dialog>
</longlink>
