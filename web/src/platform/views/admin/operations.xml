<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink name="Operations" icon="arrowUpDown">
    <State id="pages" value="${1}" />
    <State id="metadata" item="${null}" open="${false}" />
    <Query
        id="operations"
        path="/api/v1/operations?page=${pages.value}&amp;page_size=25"
    />

    <Stack gap="8">
        <Stack>
            <Heading level="1">Operations</Heading>
            <Text color="secondary">
                Track long-running Platform tasks, when they become
                available, and when they finish.
            </Text>
        </Stack>
        <Table data="$operations.items" idKey="id" hasHover="true">
            <TableColumn field="kind" header="Operation">
                <Stack align="start">
                    <Text
                        value="${({ 'solution.deploy': 'Solution deployment', 'solution.delete': 'Solution deletion', 'organization.create': 'Organization creation', 'organization.delete': 'Organization deletion' })[row.kind]}"
                    />
                    <Text type="supporting">
                        ${row.finished_at ? ({ scheduled: 'Scheduled', active: 'Active', completed: 'Completed', failed: 'Failed' })[row.status] + ' - ' + row.finished_at : 'Started - ' + row.created_at}
                    </Text>
                </Stack>
            </TableColumn>
            <TableColumn field="resource_name" header="Resource">
                <Stack align="start">
                    <Text>${row.resource_name ?? 'Resource unavailable'}</Text>
                    <Text type="supporting">
                        ${({ 'solution.deploy': 'Solution', 'solution.delete': 'Solution', 'organization.create': 'Organization', 'organization.delete': 'Organization' })[row.kind]}
                    </Text>
                </Stack>
            </TableColumn>
            <TableColumn field="id" header="Actions" align="end">
                <MoreMenu value="$metadata">
                    <Option
                        value="${{ item: row, open: true }}"
                        label="Metadata"
                        icon="info"
                    />
                </MoreMenu>
            </TableColumn>
        </Table>
        <Stack direction="horizontal" gap="2" justify="end">
            <Action>
                <Patch state="pages" value="${{ value: pages.value - 1 }}" />
                <Patch state="operations" invalidate="true" />
                <Button disabled="${pages.value === 1}">Previous</Button>
            </Action>
            <Action>
                <Patch state="pages" value="${{ value: pages.value + 1 }}" />
                <Patch state="operations" invalidate="true" />
                <Button disabled="${operations.total &lt;= pages.value * 25}">
                    Next
                </Button>
            </Action>
        </Stack>
    </Stack>

    <Dialog title="Operation metadata" isOpen="$metadata.open">
        <Stack gap="2">
            <Text>
                <b>Operation</b>
                $metadata.item.kind
            </Text>
            <Text>
                <b>Status</b>
                $metadata.item.status
            </Text>
            <Text>
                <b>ID</b>
                $metadata.item.id
            </Text>
            <Text>
                <b>Target</b>
                $metadata.item.target_id
            </Text>
            <Text>
                <b>Created</b>
                $metadata.item.created_at
            </Text>
            <Text if="$metadata.item.finished_at">
                <b>Finished</b>
                $metadata.item.finished_at
            </Text>
            <Text if="$metadata.item.failed">
                <b>Reason</b>
                $metadata.item.failed
            </Text>
        </Stack>
    </Dialog>
</longlink>
