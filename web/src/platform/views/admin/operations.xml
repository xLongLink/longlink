<?xml-model href="https://longlink.dev/docs/schema.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<longlink name="Operations" icon="arrowUpDown">
    <State id="pages" value="${1}" />
    <State id="metadata" item="${null}" open="${false}" />
    <State id="log" idValue="" open="${false}" />
    <Query id="operations" path="/api/v1/operations?page=${pages.value}&amp;page_size=25" pollInterval="5000" />
    <Query id="logs" path="/api/v1/operations/${log.idValue}/logs" if="$log.idValue" />

    <Stack gap="8">
        <Stack><Heading level="1">Operations</Heading><Text color="secondary">Track long-running Platform tasks, when they become available, and when they finish.</Text></Stack>
        <Table data="$operations.items" idKey="id" hasHover="true">
            <TableColumn field="kind" header="Operation">
                <Stack align="start"><Text>${({ 'compute.validate': 'Compute validation', 'solution.deploy': 'Solution deployment', 'solution.delete': 'Solution deletion', 'organization.create': 'Organization creation', 'organization.delete': 'Organization deletion' })[row.kind]}</Text><Text type="supporting">${row.finished_at ? ({ scheduled: 'Scheduled', active: 'Active', completed: 'Completed', failed: 'Failed' })[row.status] + ' - ' + row.finished_at : 'Started - ' + row.created_at}</Text></Stack>
            </TableColumn>
            <TableColumn field="resource.name" header="Resource">
                <Stack align="start"><Text>${row.resource?.name ?? 'Resource unavailable'}</Text><Text type="supporting">${({ 'compute.validate': 'Compute', 'solution.deploy': 'Solution', 'solution.delete': 'Solution', 'organization.create': 'Organization', 'organization.delete': 'Organization' })[row.kind]}</Text></Stack>
            </TableColumn>
            <TableColumn field="id" header="Actions">
                <Stack direction="horizontal" gap="1"><Action><Patch state="metadata" value="${{ item: row, open: true }}" /><Button variant="ghost">Metadata</Button></Action><Action><Patch state="log" value="${{ idValue: row.id, open: true }}" /><Patch state="logs" invalidate="true" /><Button variant="ghost" disabled="${row.finished_at === null}">Logs</Button></Action></Stack>
            </TableColumn>
        </Table>
        <Stack direction="horizontal" gap="2" justify="end">
            <Action><Patch state="pages" value="${{ value: pages.value - 1 }}" /><Patch state="operations" invalidate="true" /><Button disabled="${pages.value === 1}">Previous</Button></Action>
            <Action><Patch state="pages" value="${{ value: pages.value + 1 }}" /><Patch state="operations" invalidate="true" /><Button disabled="${operations.total &lt;= pages.value * 25}">Next</Button></Action>
        </Stack>
    </Stack>

    <Dialog title="Operation metadata" isOpen="$metadata.open"><Stack gap="2"><Text><b>Operation</b> $metadata.item.kind</Text><Text><b>Status</b> $metadata.item.status</Text><Text><b>ID</b> $metadata.item.id</Text><Text><b>Target</b> $metadata.item.target_id</Text><Text><b>Created</b> $metadata.item.created_at</Text><Text if="$metadata.item.finished_at"><b>Finished</b> $metadata.item.finished_at</Text><Text if="$metadata.item.failed"><b>Reason</b> $metadata.item.failed</Text></Stack></Dialog>
    <Dialog title="Operation logs" isOpen="$log.open"><CodeBlock value="$logs" /></Dialog>
</longlink>
