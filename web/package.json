{
    "name": "web",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "scripts": {
        "build:views": "vp build --config vite.views.config.ts",
        "build": "vp run build:views && vp run typecheck && react-router build --mode api --logLevel warn && react-router build --mode sdk --logLevel warn",
        "check": "vp check",
        "typecheck": "tsc -b",
        "build:api": "vp run typecheck && react-router build --mode api",
        "build:api:bundle": "react-router build --mode api",
        "build:sdk": "vp run build:views && vp run typecheck && react-router build --mode sdk",
        "build:sdk:bundle": "vp run build:views && react-router build --mode sdk",
        "export:platform-api": "uv --directory ../api run --env-file .env.sample python -m scripts.openapi",
        "format": "vp fmt --write && vp lint --fix-suggestions",
        "generate:platform-api": "vp run export:platform-api && openapi-ts --file openapi-ts.config.ts",
        "generate:frontend": "node scripts/frontend.mjs",
        "check:frontend": "node scripts/frontend.mjs --check && node --test scripts/frontend.check.mjs",
        "check:platform-api": "vp run generate:platform-api && git diff --exit-code -- ../api/openapi/v1.json src/lib/generated/platform-api-v1",
        "dev": "react-router dev --mode api",
        "dev:sdk": "vp run build:views && react-router dev --mode sdk",
        "routes": "react-router routes",
        "ui": "shadcn"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@base-ui/utils": "0.5.0",
        "@dicebear/core": "^10.7.0",
        "@dicebear/styles": "^10.6.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@hookform/resolvers": "^7.0.3",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-table": "9.3.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "date-fns": "4.4.0",
        "es-toolkit": "^1.53.2",
        "isbot": "^5",
        "ky": "^2.2.0",
        "lucide-react": "^1.70.0",
        "react": "^19.3.1",
        "react-day-picker": "10.0.2",
        "react-dom": "^19.3.1",
        "react-error-boundary": "^6.1.6",
        "react-hook-form": "^7.91.0",
        "react-router": "8.5.1",
        "react-simple-maps": "^5.0.5",
        "recharts": "3.8.0",
        "shiki": "4.6.0",
        "sonner": "2.0.8",
        "sucrase": "^3.35.1",
        "topojson-client": "^3.1.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@hey-api/openapi-ts": "0.99.0",
        "@oxlint/plugins": "1.92.0",
        "@react-router/dev": "8.5.1",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/topojson-client": "^3.1.5",
        "dts-bundle-generator": "^10.0.0",
        "eslint-plugin-perfectionist": "^5.13.0",
        "happy-dom": "^21.0.4",
        "shadcn": "4.23.0",
        "tailwindcss": "^4.3.5",
        "typescript": "5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
        "vite-plus": "1.5.0",
        "vitest": "5.1.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "26.12.0",
            "onFail": "download"
        }
    }
}
