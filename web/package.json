{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "theme": "vp exec astryx theme build src/theme.ts --out src/lib/generated/stone.css",
        "build": "vp run check:docs && vp run typecheck && react-router build --mode api --logLevel warn && react-router build --mode sdk --logLevel warn",
        "check": "vp check",
        "typecheck": "vp run typecheck:api && vp run typecheck:sdk",
        "typecheck:api": "react-router typegen --mode api && tsc -b",
        "typecheck:sdk": "react-router typegen --mode sdk && tsc -b",
        "build:api": "vp run check:docs && vp run typecheck:api && react-router build --mode api",
        "build:api:container": "vp run generate:docs && vp run typecheck:api && react-router build --mode api",
        "build:api:bundle": "vp run check:docs && react-router build --mode api",
        "build:sdk": "vp run typecheck:sdk && react-router build --mode sdk",
        "build:sdk:bundle": "react-router build --mode sdk",
        "export:platform-api": "uv --directory ../api run --env-file .env.sample python -m scripts.openapi",
        "generate:docs": "node scripts/documentation.mjs",
        "check:docs": "vp run generate:docs && git diff --exit-code -- src/lib/generated/documentation.ts",
        "format": "vp fmt --write && vp lint --fix-suggestions",
        "generate:platform-api": "vp run export:platform-api && openapi-ts --file openapi-ts.config.ts",
        "check:platform-api": "vp run generate:platform-api && git diff --exit-code -- ../api/openapi/v1.json src/lib/generated/platform-api-v1",
        "dev": "react-router dev --mode api",
        "dev:sdk": "react-router dev --mode sdk",
        "routes": "react-router routes",
        "test": "vp test tests"
    },
    "dependencies": {
        "@astryxdesign/core": "0.6.1",
        "@fontsource/kalam": "^5.3.0",
        "@hookform/resolvers": "^5.9.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.102.8",
        "acorn": "^8.17.0",
        "es-toolkit": "^1.52.0",
        "fast-xml-parser": "^5.11.1",
        "isbot": "^5",
        "ky": "^2.1.0",
        "lucide-react": "^1.41.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-hook-form": "^7.88.0",
        "react-router": "8.3.1",
        "tailwindcss": "^4.3.3",
        "valtio": "^2.3.2",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.6.1",
        "@hey-api/openapi-ts": "0.99.0",
        "@prettier/plugin-xml": "^3.4.2",
        "@react-router/dev": "8.4.0",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint-plugin-perfectionist": "^5.11.1",
        "happy-dom": "^20.14.0",
        "prettier": "^3.9.8",
        "typescript": "5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
        "vite-plus": "0.3.1",
        "vitest": "5.0.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "24.18.0",
            "onFail": "download"
        }
    }
}
