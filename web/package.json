{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "theme": "vp exec astryx theme build src/theme.ts --out src/lib/generated/stone.css",
        "build": "vp run typecheck && react-router build --mode api --logLevel warn && react-router build --mode sdk --logLevel warn",
        "check": "vp check",
        "typecheck": "vp run typecheck:api && vp run typecheck:sdk",
        "typecheck:api": "react-router typegen --mode api && tsc -b",
        "typecheck:sdk": "react-router typegen --mode sdk && tsc -b",
        "build:api": "vp run typecheck:api && react-router build --mode api",
        "build:api:bundle": "react-router build --mode api",
        "build:sdk": "vp run typecheck:sdk && react-router build --mode sdk",
        "build:sdk:bundle": "react-router build --mode sdk",
        "export:platform-api": "DEVELOPMENT=true uv --directory ../api run python -m scripts.openapi",
        "generate:globe-land": "bun scripts/generate-globe-land.ts",
        "format": "vp fmt --write && vp lint --fix-suggestions",
        "generate:platform-api": "vp run export:platform-api && openapi-ts --file openapi-ts.config.ts",
        "check:platform-api": "vp run generate:platform-api && git diff --exit-code -- ../api/openapi/v1.json src/lib/generated/platform-api-v1",
        "dev": "react-router dev --mode api",
        "dev:sdk": "react-router dev --mode sdk",
        "routes": "react-router routes",
        "test": "vp test tests"
    },
    "dependencies": {
        "@astryxdesign/core": "0.5.1",
        "@fontsource-variable/caveat": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.102.0",
        "acorn": "^8.17.0",
        "fast-xml-parser": "^5.11.0",
        "isbot": "^5",
        "ky": "^2.0.2",
        "lucide-react": "^1.33.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router": "8.3.0",
        "tailwindcss": "^4.3.3",
        "valtio": "^2.3.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.5.1",
        "@hey-api/openapi-ts": "0.99.0",
        "@react-router/dev": "8.3.0",
        "@types/d3-geo": "^3.1.1",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/topojson-client": "^3.1.5",
        "d3-geo": "^3.1.1",
        "eslint-plugin-perfectionist": "^5.10.1",
        "happy-dom": "^20.11.6",
        "topojson-client": "^3.1.0",
        "typescript": "5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
        "vite-plus": "0.2.9",
        "world-atlas": "^2.0.2"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "24.18.0",
            "onFail": "download"
        }
    }
}
