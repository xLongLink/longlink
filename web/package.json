{
    "name": "web",
    "private": true,
    "license": "Apache-2.0",
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "theme": "vp exec astryx theme build src/theme.ts --out src/lib/generated/stone.css --icons-specifier ../glyphs",
        "build:views": "vp run theme && vp build --config vite.views.config.ts",
        "build": "vp run build:views && vp run typecheck && react-router build --mode api --logLevel warn && react-router build --mode sdk --logLevel warn",
        "check": "vp check",
        "typecheck": "vp run typecheck:api && vp run typecheck:sdk",
        "typecheck:api": "react-router typegen --mode api && tsc -b",
        "typecheck:sdk": "react-router typegen --mode sdk && tsc -b",
        "build:api": "vp run theme && vp run typecheck:api && react-router build --mode api",
        "build:api:bundle": "vp run theme && react-router build --mode api",
        "build:sdk": "vp run build:views && vp run typecheck:sdk && react-router build --mode sdk",
        "build:sdk:bundle": "vp run build:views && react-router build --mode sdk",
        "export:platform-api": "uv --directory ../api run --env-file .env.sample python -m scripts.openapi",
        "format": "vp fmt --write && vp lint --fix-suggestions",
        "generate:platform-api": "vp run export:platform-api && openapi-ts --file openapi-ts.config.ts",
        "check:platform-api": "vp run generate:platform-api && git diff --exit-code -- ../api/openapi/v1.json src/lib/generated/platform-api-v1",
        "dev": "vp run theme && react-router dev --mode api",
        "dev:sdk": "vp run build:views && react-router dev --mode sdk",
        "routes": "react-router routes"
    },
    "dependencies": {
        "@astryxdesign/core": "0.7.1",
        "@dicebear/core": "^10.7.0",
        "@dicebear/styles": "^10.6.0",
        "@fontsource/figtree": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/kalam": "^5.3.0",
        "@fontsource/montserrat": "^5.3.0",
        "@hookform/resolvers": "^5.9.2",
        "@tanstack/react-query": "^5.102.8",
        "es-toolkit": "^1.52.0",
        "isbot": "^5",
        "ky": "^2.1.0",
        "lucide-react": "^1.59.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-error-boundary": "^6.1.6",
        "react-hook-form": "^7.91.0",
        "react-router": "8.4.0",
        "sucrase": "^3.35.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.7.1",
        "@hey-api/openapi-ts": "0.99.0",
        "@oxlint/plugins": "1.81.0",
        "@react-router/dev": "8.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "happy-dom": "^21.0.4",
        "tailwindcss": "^4.3.3",
        "typescript": "5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plus": "1.3.0",
        "vitest": "4.1.11",
        "yaml": "^2.9.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "26.12.0",
            "onFail": "download"
        }
    }
}
