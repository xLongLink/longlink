{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "theme:build": "vp exec astryx theme build src/lib/default-theme.ts --out src/lib/generated/longlink-neutral-default.css",
        "typecheck": "vp run typecheck:api && vp run typecheck:sdk",
        "typecheck:api": "react-router typegen --mode api && tsc -b",
        "typecheck:sdk": "react-router typegen --mode sdk && tsc -b",
        "build:api": "vp run typecheck:api && react-router build --mode api",
        "build:api:bundle": "react-router build --mode api",
        "build:sdk": "vp run typecheck:sdk && react-router build --mode sdk",
        "build:sdk:bundle": "react-router build --mode sdk",
        "dev": "react-router dev --mode api",
        "dev:sdk": "react-router dev --mode sdk",
        "test": "vp test tests/xml"
    },
    "dependencies": {
        "@astryxdesign/core": "0.1.8",
        "@astryxdesign/theme-neutral": "0.1.8",
        "@fontsource-variable/inter": "^5.3.0",
        "@hookform/resolvers": "^5.4.0",
        "@stylexjs/stylex": "0.19.0",
        "@tailwindcss/vite": "^4.3.2",
        "@tanstack/react-query": "^5.101.2",
        "acorn": "^8.17.0",
        "d3-geo": "^3.1.1",
        "fast-xml-parser": "^5.10.1",
        "isbot": "^5.1.40",
        "lodash": "^4.18.1",
        "lucide-react": "^1.25.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hook-form": "^7.81.0",
        "react-router": "8.3.0",
        "tailwindcss": "^4.3.2",
        "topojson-client": "^3.1.0",
        "ufo": "^1.6.4",
        "valtio": "^2.3.2",
        "world-atlas": "^2.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.1.8",
        "@happy-dom/global-registrator": "^20.10.6",
        "@react-router/dev": "8.3.0",
        "@types/d3-geo": "^3.1.0",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/topojson-client": "^3.1.5",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
        "vite-plus": "0.2.6"
    },
    "overrides": {
        "@babel/core": "7.29.7",
        "brace-expansion": "5.0.8",
        "flatted": "3.4.2",
        "js-yaml": "4.3.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
    },
    "astryx": {
        "theme": "@astryxdesign/theme-neutral"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "24.18.0",
            "onFail": "download"
        }
    }
}
