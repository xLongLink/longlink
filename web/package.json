{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "theme": "vp exec astryx theme build src/themes/stone/stoneTheme.ts --out src/lib/generated/stone.css",
        "build": "vp run build:prepared",
        "build:prepared": "react-router typegen --mode api && tsc -b && react-router typegen --mode sdk && tsc -b && react-router build --mode api --logLevel warn && react-router build --mode sdk --logLevel warn",
        "check": "vp check",
        "typecheck": "react-router typegen --mode api && tsc -b && react-router typegen --mode sdk && tsc -b",
        "typecheck:api": "react-router typegen --mode api && tsc -b",
        "typecheck:sdk": "react-router typegen --mode sdk && tsc -b",
        "build:api": "vp run typecheck:api && react-router build --mode api",
        "build:api:bundle": "react-router build --mode api",
        "build:sdk": "vp run typecheck:sdk && react-router build --mode sdk",
        "build:sdk:bundle": "react-router build --mode sdk",
        "export:platform-api": "uv --project ../api run python ../api/scripts/export_openapi.py",
        "generate:platform-api": "vp run export:platform-api && openapi-ts --file openapi-ts.config.ts",
        "check:platform-api": "vp run generate:platform-api && git diff --exit-code -- ../api/openapi/v1.json src/lib/generated/platform-api-v1",
        "dev": "react-router dev --mode api",
        "dev:sdk": "react-router dev --mode sdk",
        "routes": "react-router routes",
        "test": "vp test tests/xml"
    },
    "dependencies": {
        "@astryxdesign/core": "0.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@hookform/resolvers": "^5.5.7",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.101.4",
        "acorn": "^8.17.0",
        "d3-geo": "^3.1.1",
        "fast-xml-parser": "^5.10.1",
        "isbot": "^5.2.1",
        "lodash": "^4.18.1",
        "lucide-react": "^1.28.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.84.0",
        "react-router": "8.3.0",
        "tailwindcss": "^4.3.3",
        "topojson-client": "^3.1.0",
        "ufo": "^1.6.4",
        "valtio": "^2.3.2",
        "world-atlas": "^2.0.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.3.0",
        "@hey-api/openapi-ts": "0.99.0",
        "@react-router/dev": "8.3.0",
        "@types/d3-geo": "^3.1.1",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/topojson-client": "^3.1.5",
        "typescript": "5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
        "vite-plus": "0.2.6"
    },
    "overrides": {
        "@babel/core": "7.29.7",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "24.18.0",
            "onFail": "download"
        }
    }
}
