environments:
    default:
        values:
            - infrastructure: ./infrastructure
            - storageClass: block-storage
    development:
        values:
            - infrastructure: ./infrastructure
    single-node:
        values:
            - infrastructure: ./infrastructure
            - storageClass: block-storage
---
repositories:
    - name: cnpg
      url: https://cloudnative-pg.github.io/charts
    - name: rustfs
      url: https://charts.rustfs.com

helmDefaults:
    wait: true
    timeout: 900

releases:
    - name: serving-crds
      namespace: knative-serving
      chart: ./operators/serving-crds
      hooks:
          - events: [presync]
            showlogs: true
            command: kubectl
            args:
                - delete
                - configmap
                - compute-release
                - --namespace=longlink-system
                - --ignore-not-found

    - name: serving
      namespace: knative-serving
      chart: ./operators/serving
      needs:
          - knative-serving/serving-crds
      hooks:
          - events: [postsync]
            showlogs: true
            command: kubectl
            args:
                - wait
                - --for=jsonpath={.webhooks[*].clientConfig.caBundle}
                - validatingwebhookconfiguration/config.webhook.serving.knative.dev
                - mutatingwebhookconfiguration/webhook.serving.knative.dev
                - validatingwebhookconfiguration/validation.webhook.serving.knative.dev
                - --timeout=180s

    - name: kourier
      # Preserve upstream's split between knative-serving and kourier-system.
      # A release namespace would make Chartify rewrite both into one namespace.
      chart: ./operators/kourier
      needs:
          - knative-serving/serving

    - name: cnpg
      namespace: cnpg-system
      chart: cnpg/cloudnative-pg
      version: 0.28.1
      values:
          - fullnameOverride: cnpg-controller-manager
      hooks:
          - events: [postsync]
            showlogs: true
            command: sh
            args:
                - -ec
                - |
                    for configuration in mutatingwebhookconfiguration/cnpg-mutating-webhook-configuration validatingwebhookconfiguration/cnpg-validating-webhook-configuration; do
                        hooks="$(kubectl get "$configuration" -o jsonpath='{.webhooks[*].name}')"
                        test -n "$hooks"
                        for hook in $hooks; do
                            kubectl wait --for="jsonpath={.webhooks[?(@.name=='$hook')].clientConfig.caBundle}" "$configuration" --timeout=180s
                        done
                    done

    - name: rustfs
      namespace: rustfs
      chart: rustfs/rustfs
      version: 1.0.0-rc.6
      values:
          - image:
                rustfs:
                    repository: rustfs/rustfs
                    tag: 1.0.0-rc.6@sha256:97171b3d72cd47dc81000f92ea84de25608bfc35a94c965501afaeb5d99f6035
            secret:
                existingSecret: longlink-rustfs
            service:
                type: ClusterIP
            ingress:
                enabled: false
            {{- if eq .Environment.Name "development" }}
            replicaCount: 1
            mode:
                standalone:
                    enabled: true
                distributed:
                    enabled: false
            storageclass:
                name: local-path
                dataStorageSize: 1Gi
                logStorageSize: 1Gi
            {{- else if eq .Environment.Name "single-node" }}
            replicaCount: 1
            mode:
                standalone:
                    enabled: true
                distributed:
                    enabled: false
            storageclass:
                name: {{ .Values.storageClass }}
                dataStorageSize: 100Gi
                logStorageSize: 1Gi
            {{- else }}
            replicaCount: 4
            drivesPerNode: 1
            storageclass:
                name: {{ .Values.storageClass }}
                dataStorageSize: 100Gi
                logStorageSize: 1Gi
            {{- end }}

    - name: storage
      namespace: rustfs
      chart: {{ .Values.infrastructure }}
      needs:
          - rustfs/rustfs
      hooks:
          - events: [postsync]
            showlogs: true
            command: kubectl
            args:
                - wait
                - --for=condition=available
                - deployment/longlink-storage
                - --namespace=rustfs
                - --timeout=900s

    # Publish readiness only after every controller and the object store are ready.
    - name: compute-release
      chart: ./release
      needs:
          - kourier
          - cnpg-system/cnpg
          - rustfs/storage
