{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["gateway", "storage", "runtimeEgressCidr"],
    "properties": {
    "gateway": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": { "type": "string", "format": "ipv4", "minLength": 1 }
      }
    },
    "storage": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": { "type": "string", "format": "ipv4", "minLength": 1 }
      }
    },
    "runtimeEgressCidr": { "type": "string", "minLength": 1 }
  }
}
