# Copy to dev/.env.seed to customize the local sample registration.
# make up creates dev/kubeconfig.yaml and the local gateway CA.
# The API administrator credentials and browser origin come from api/.env.

# Platform API
API_URL=http://127.0.0.1:8000
COMPUTE_TIMEOUT_SECONDS=300

# PostgreSQL: one CNPG instance per organization, using filesystem PVCs.
DATABASE_STORAGE_CLASS=local-path
DATABASE_SIZE_GIB=10
DATABASE_INSTANCES=1

# Object storage: dev tooling prepares this development-only CSI class,
# loop-backed Block PVCs for Ceph, and the storage TLS certificate.
# No external storage account or provider API keys are required.
STORAGE_CLASS=longlink-development
STORAGE_ENDPOINT=https://storage.localhost:9443
STORAGE_SIZE_GIB=1
STORAGE_INSTANCES=1
BUCKET_SIZE_BYTES=134217728
BUCKET_MAX_OBJECTS=1000
STORAGE_RESERVE_PERCENT=30
STORAGE_OBJECT_OVERHEAD_BYTES=65536

# make seed supplies the gateway and storage CA bundles. For a custom local
# Compute, supply its kubeconfig, endpoints, and CA trust bundles as needed.
