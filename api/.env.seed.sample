# Copy to api/.env.seed. These values match the local development defaults.
# make up creates api/kubeconfig.yaml and the local gateway CA.
KUBECONFIG=kubeconfig.yaml
GATEWAY_URL=https://localhost:8443

# PostgreSQL: one CNPG instance per organization, using filesystem PVCs.
DATABASE_STORAGE_CLASS=local-path
DATABASE_SIZE_GIB=10
DATABASE_INSTANCES=1

# Object storage: make up and local seeding prepare this development-only CSI
# class, loop-backed Block PVCs for Ceph, and the storage TLS certificate.
# No external storage account or provider API keys are required.
STORAGE_CLASS=longlink-development
STORAGE_ENDPOINT=https://rook-ceph-rgw-longlink.rook-ceph.svc:443
STORAGE_SIZE_GIB=20
STORAGE_INSTANCES=1

# Host-run development connections use authenticated Kubernetes tunnels.
# make seed supplies GATEWAY_CERTIFICATE; the default local storage setup
# supplies STORAGE_CERTIFICATE from the same CA. No certificate values are
# needed here for the default setup.
#
# For a custom compute, supply its kubeconfig, durable backing StorageClass,
# HTTPS endpoints and CA trust bundles as needed. Production Ceph uses
# STORAGE_INSTANCES=3 across three nodes; the local CSI driver is not for production.
