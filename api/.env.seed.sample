# Compute: make up generate the kubeconfig.yml in the api folder.
KUBECONFIG=kubeconfig.yaml

# Storage: Need to be tested on a Live system
# Create an account on Exoscale and generate an API key pair.
EXOSCALE_API_KEY=replace-with-the-api-key
EXOSCALE_API_SECRET=replace-with-the-api-secret
EXOSCALE_STORAGE_ENDPOINT_URL=https://sos-ch-gva-2.exo.io

# Database: Can be either local or remote.
APPLICATION_DATABASE_URL=postgresql://admin:admin@localhost:15432/admin?sslmode=disable
