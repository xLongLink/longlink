# Session signing key used by the auth cookie.
SESSION_KEY=replace-with-a-long-random-secret

# Public web URL used in account verification and password reset links.
PUBLIC_URL=http://localhost:5173

# Optional OAuth clients. Register callbacks at /api/v1/auth/oauth/google/callback and /api/v1/auth/oauth/github/callback.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Required Platform administrator, reconciled as the sole administrator during Platform startup.
ADMIN_NAME="Example LongLink"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=longlink-admin

# SMTP delivery for verification and password reset emails.
# make up runs Mailpit; use a real SMTP provider in hosted deployments.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_START_TLS=false
SMTP_FROM=no-reply@longlink.dev
# SMTP_USERNAME=no-reply@example.com
# SMTP_PASSWORD=replace-with-the-smtp-password

# Key used to encrypt infrastructure credentials stored by the Platform.
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Main database used by the LongLink Platform.
# DATABASE_URL=mysql+aiomysql://user:password@db.example.com:3306/longlink
# DATABASE_URL=postgresql+asyncpg://user:password@db.example.com:3306/longlink
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Explicitly allow the local registry alongside public GHCR for this workstation.
IMAGE_REGISTRIES='{"ghcr.io":"https://ghcr.io","localhost:15000":"http://localhost:15000"}'
